    parser add argument 
         --dataset-repo-id  
        type str 
        required help  huggingface dataset repo id local path  
     
    parser add argument 
         --reward-model-path  
        type str 
        default help  path pretrained sarm model  reads existing parquet metadata provided   
     
    parser add argument 
         --output-path  
        type str 
        default help  output path parquet set  saves dataset s cache directory  
     
    parser add argument 
         --head-mode  
        type str 
        default  sparse  
        choices   sparse    dense    both   
        help  sarm head use  default  sparse   
     
    parser add argument 
         --device  
        type str 
        default  cuda  
        help  device use  default  cuda   
     
     
    parser add argument 
         --visualize-only  
        action  store help  only visualize sarm predictions ra-bc computation   
     
    parser add argument 
