 

 
 
 
 
 
 
 
 
 
 
 
 
 
 
 


 dataclass rebotarm102leaderconfig 
     

     
    port  str

    baudrate  int   1 000 000

     
    joint ids  dict str  int    field 
        default factory shoulder pan   0 
             shoulder lift   1 
             elbow flex   2 
             wrist flex   3 
             wrist yaw   4 
             wrist roll   5 
             gripper   6 
         
     

     
     
     
    joint directions  dict str  int    field 
        default factory shoulder pan   -1 
             shoulder lift   -1 
             elbow flex   1 
             wrist flex   1 
             wrist yaw   1 
             wrist roll   -1 
             gripper   -6 
         
     

     
     
    joint ranges  dict str  list int     field 
        default factory shoulder pan    -150  150  
             shoulder lift    -200  1  
             elbow flex    -200  1  
             wrist flex    -80  90  
             wrist yaw    -90  90  
             wrist roll    -90  90  
             gripper    -270  0  
         
     


 teleoperatorconfig register subclass  rebot 102 leader  
 dataclass rebotarm102leaderteleopconfig teleoperatorconfig  rebotarm102leaderconfig   src lerobot teleoperators rebot 102 leader config rebot 102 leader