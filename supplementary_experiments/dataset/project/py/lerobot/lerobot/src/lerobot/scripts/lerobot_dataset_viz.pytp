    parser   argparse argumentparser  

    parser add argument 
         --repo-id  
        type str 
        required help  name hugging face repository containing lerobotdataset dataset  e g  `lerobot pusht`    
     
    parser add argument 
         --episode-index  
        type int 
        required help  episode visualize   
     
    parser add argument 
         --root  
        type path 
        default help  root directory dataset stored locally  e g  `--root data default dataset loaded hugging face cache folder downloaded hub available   
     
    parser add argument 
         --output-dir  
        type path 
        default help  directory path write rrd file save 1 set   
     
    parser add argument 
         --batch-size  
        type int 
        default 32 
        help  batch size loaded dataloader   
     
    parser add argument 
         --num-workers  
        type int 
        default 4 
        help  number processes dataloader loading data   
     
    parser add argument 
         --mode  
        type str 
        default  local  
        help  
             mode viewing between  local distant    
              local  requires data local machine spawns viewer visualize data locally   
              distant  creates server distant machine data stored   
             visualize data connecting server rerun rerun http   ip grpc port proxy local machine  
          
     
    parser add argument 
         --web-port  
        type int 
        default help  
             web websocket port rerun `--mode distant web viewer port  default 9090 display-mode foxglove server bind port  default 8765   
          
     
    parser add argument 
         --grpc-port  
        type int 
        default 9876 
        help  grpc port rerun io mode distant set   
     
    parser add argument 
         --save  
        type int 
        default 0 
        help  
             save rrd file directory provided output-dir deactivates spawning viewer   
             visualize data running `rerun path file rrd local machine  
          
     

    parser add argument 
         --tolerance-s  
        type float 
        default 1e-4 
        help  
             tolerance seconds used ensure data timestamps respect dataset fps value argument passed constructor lerobotdataset maps tolerance s constructor argument given  defaults 1e-4  
          
     

    parser add argument 
         --display-compressed-images  
        action  store help set  display compressed  jpeg  images instead uncompressed ones   
     

    parser add argument 
         --display-mode  
        type str 
        default  rerun  
        choices   rerun    foxglove   
        help  
             visualization backend   rerun  uses rerun viewer  --mode --save -- -port apply    
              foxglove  starts foxglove websocket server serves episode seekable   
             scrubbable timeline  connect foxglove app ws   host port  --host --web-port   
          
     
    parser add argument 
         --host  
        type str 
        default  127 0 0 1  
        help  
             host bind foxglove websocket server display-mode foxglove set  
              127 0 0 1 local only  0 0 0 0 interfaces   
          
     
