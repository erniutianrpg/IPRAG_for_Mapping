 

 
 
 
 
 
 
 
 
 
 
 
 
 
 
 
 


 dataclass rebotb601followerconfig 
     

     
     
     
    port  str adapter  str    damiao 

     
    dm serial baud  int   921600

    disable torque disconnect  bool max relative target  float   dict str  float none

     
    cameras  dict str  cameraconfig    field default factory dict 

     
    motor ids  dict str  tuple int  int     field 
        default factory shoulder pan    0x01  0x11  
             shoulder lift    0x02  0x12  
             elbow flex    0x03  0x13  
             wrist flex    0x04  0x14  
             wrist yaw    0x05  0x15  
             wrist roll    0x06  0x16  
             gripper    0x07  0x17  
         
     

     
    pos vel velocity  float   list float    field 
        default factory 150 0  150 0  150 0  150 0  150 0  150 0  900 0 
     

     
    control mode  str    mit 

     
    mit kp  float   list float    field default factory 45 0  45 0  45 0  8 0  9 0  8 0  8 0  
    mit kd  float   list float    field default factory 12 0  12 0  12 0  1 0  1 0  1 0  1 0  

     
    gripper control mode  str    force pos 

     
    gripper torque ratio  float   0 07

     
    gripper mit kp  float   8 0
    gripper mit kd  float   0 3

     
    joint limits  dict str  tuple float  float     field 
        default factory shoulder pan    -150 0  150 0  
             shoulder lift    -200 0  1 0  
             elbow flex    -200 0  1 0  
             wrist flex    -80 0  90 0  
             wrist yaw    -90 0  90 0  
             wrist roll    -90 0  90 0  
             gripper    -270 0  0 0  
         
     


