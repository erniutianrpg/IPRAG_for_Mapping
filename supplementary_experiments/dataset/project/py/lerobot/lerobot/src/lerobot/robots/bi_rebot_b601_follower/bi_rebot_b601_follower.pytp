 

 
 
 
 
 
 
 
 
 
 
 
 
 
 
 
 
 
 
 
 
 

logger   logging getlogger   name birebotb601follower bimanualmixin  robot  
     

    config birebotb601followerconfig
    name    bi rebot b601 follower init config  birebotb601followerconfig  
        super     init   config config   config top level cam keys   set config cameras 
         collisions top level cam keys   set 
            config left arm config cameras top level cam keys   set config right arm config cameras collisions valueerror 
                f top-level camera names collide per-arm camera names   sorted  collisions   
             
        left arm cameras      config left arm config cameras    config cameras 

        left arm config   rebotb601followerrobotconfig 
            id f  config id  left config id calibration dir config calibration dir 
            port config left arm config port adapter config left arm config adapter 
            dm serial baud config left arm config dm serial baud 
            disable torque disconnect config left arm config disable torque disconnect 
            max relative target config left arm config max relative target 
            cameras left arm cameras 
            motor ids config left arm config motor ids 
            pos vel velocity config left arm config pos vel velocity 
            control mode config left arm config control mode 
            mit kp config left arm config mit kp 
            mit kd config left arm config mit kd 
            gripper control mode config left arm config gripper control mode 
            gripper torque ratio config left arm config gripper torque ratio 
            gripper mit kp config left arm config gripper mit kp 
            gripper mit kd config left arm config gripper mit kd 
            joint limits config left arm config joint limits 
         

        right arm config   rebotb601followerrobotconfig 
            id f  config id  right config id calibration dir config calibration dir 
            port config right arm config port adapter config right arm config adapter 
            dm serial baud config right arm config dm serial baud 
            disable torque disconnect config right arm config disable torque disconnect 
            max relative target config right arm config max relative target 
            cameras config right arm config cameras 
            motor ids config right arm config motor ids 
            pos vel velocity config right arm config pos vel velocity 
            control mode config right arm config control mode 
            mit kp config right arm config mit kp 
            mit kd config right arm config mit kd 
            gripper control mode config right arm config gripper control mode 
            gripper torque ratio config right arm config gripper torque ratio 
            gripper mit kp config right arm config gripper mit kp 
            gripper mit kd config right arm config gripper mit kd 
            joint limits config right arm config joint limits left arm   rebotb601follower left arm config right arm   rebotb601follower right arm config cameras left arm cameras right arm cameras 

     property motors ft dict str  type f left  k    v k  v left arm  motors ft items    
               f right  k    v k  v right arm  motors ft items    
         

     property cameras ft dict str  tuple  
        out  dict str  tuple k  v left arm  cameras ft items   
            out k k top level cam keys f left  k      v k  v right arm  cameras ft items   
            out f right  k      v out

     cached property observation features dict str  type   tuple motors ft cameras ft 

     cached property action features dict str  type motors ft

     check connected observation robotobservation 
        obs dict  robotobservation k  v left arm observation   items   
            obs dict k k top level cam keys f left  k      v k  v right arm observation   items   
            obs dict f right  k      v obs dict

     check connected send action action  robotaction  -  robotaction 
        left action    
            key removeprefix  left     value key  value action items key startswith  left   
         
        right action    
            key removeprefix  right     value key  value action items key startswith  right   
         

        sent action left left arm send action left action 
        sent action right right arm send action right action f left  k    v k  v sent action left items    
               f right  k    v k  v sent action right items    
         
  src lerobot robots bi rebot b601 follower bi rebot b601 follower