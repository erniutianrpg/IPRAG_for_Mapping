 lekiwi cameras config   -  dict str  cameraconfig front   opencvcameraconfig 
            index path   dev video0   fps 30  width 640  height 480  rotation cv2rotation rotate 180
          
         wrist   opencvcameraconfig 
            index path   dev video2   fps 30  width 480  height 640  rotation cv2rotation rotate 90
          
     


 robotconfig register subclass  lekiwi  
 dataclass lekiwiconfig robotconfig  
    port  str     dev ttyacm0    

    disable torque disconnect  bool max relative target  float   dict str  float none

    cameras  dict str  cameraconfig    field default factory lekiwi cameras config 

     
    use degrees  bool dataclass lekiwihostconfig 
     
    port zmq cmd  int   5555
    port zmq observations  int   5556

     
    connection time s  int   30

     
    watchdog timeout ms  int   500

     
    max loop freq hz  int   30


 robotconfig register subclass  lekiwi client  
 dataclass lekiwiclientconfig robotconfig  
     
    remote ip  str
    port zmq cmd  int   5555
    port zmq observations  int   5556

    teleop keys  dict str  str    field 
        default factory forward    w  
             backward    s  
             left right    d  
             rotate left    z  
             rotate right    x  
             
             speed up    r  
             speed down    f  
             
             quit    q  
         
     

    cameras  dict str  cameraconfig    field default factory lekiwi cameras config 

    polling timeout ms  int   15
    connect timeout s  int   5
  src lerobot robots lekiwi config lekiwi