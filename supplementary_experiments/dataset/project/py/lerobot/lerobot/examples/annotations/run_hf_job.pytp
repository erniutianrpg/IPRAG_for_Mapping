 

 
 
 
 
 
 
 
 
 
 
 
 
 
 
 

token   os environ hf token token token runtimeerror hf token  run `huggingface-cli login export hf token hf    `  

cmd    
     apt update -qq    apt install -y -qq git ffmpeg     
     pip install deps  
      lerobot   git https   github com huggingface lerobot git main      
     pip install --upgrade-strategy only needed  
     datasets pyarrow av jsonlines draccus gymnasium torchcodec mergedeep pyyaml-include toml typing-inspect  
     openai     
     export vllm memory profiler estimate cudagraphs 0     
     export vllm video backend pyav     
     lerobot-annotate  
     --repo id pepijn223 robocasa pretrain human300 v4  
     --new repo id pepijn223 robocasa pretrain human300 v4 annotated  
     --push hub vlm backend openai  
     --vlm model id qwen qwen3 6-27b  
     --vlm num gpus 1  
     --vlm serve command  vllm serve qwen qwen3 6-27b  
     --tensor-parallel-size 1 --max-model-len 32768  
     --gpu-memory-utilization 0 8 --uvicorn-log-level warning --port  port    
     --vlm serve ready timeout s 1800  
     
     --vlm chat template kwargs   \ enable thinking job   run job 
    image  vllm vllm-openai latest  
    command   bash    -c   cmd  
    flavor  h200  
    secrets   hf token   token  
    timeout  2h  
 
print f job url   job url   
print f job id    job id   
  examples annotations run hf job