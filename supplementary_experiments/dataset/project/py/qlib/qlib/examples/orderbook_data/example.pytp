 testclass unittest testcase setup provider uri    ~  qlib qlib data yahoo cn 1min 
        qlib init 
            provider uri provider uri 
            mem cache size limit 1024  3   2 
            mem cache type  sizeof  
            kernels 1 
            expression provider localexpressionprovider    kwargs     time2idx feature provider arcticfeatureprovider  
                 module path    qlib contrib data data  
                 kwargs     uri    127 0 0 1   
              
            dataset provider localdatasetprovider  
                 kwargs    
                     align time stocks list     sz000725 test basic df   d features stocks list 
            fields   $ask1    $ask2    $bid1    $bid2   
            freq  ticks  
            start time  20201230  
            end time  20210101  
         
        print df test basic without time df   d features stocks list  fields   $ask1    freq  ticks  
        print df test basic01 df   d features stocks list 
            fields   tresample $ask1   1min    last     
            freq  ticks  
            start time  20201230  
            end time  20210101  
         
        print df test basic02 df   d features stocks list 
            fields   $function code   
            freq  transaction  
            start time  20201230  
            end time  20210101  
         
        print df test basic03 df   d features stocks list 
            fields   $function code   
            freq  order  
            start time  20201230  
            end time  20210101  
         
        print df 

     
     
    expr sum buy ask 1     tresample $ask1   1min    last     tresample $bid1   1min    last    
    total volume    
         tresample  
              join  f $ name i range 1  11 name asize    bsize    
              1min    sum   
     

     staticmethod total func name  method tresample         join  f $ name i range 1  11         1min          format method test exp 01 exprs     
        names name asize    bsize range 1  11  
                exprs append f tresample $ name 1min    mean total volume    
                names append f v  name df   d features stocks list  fields exprs  freq  ticks  
        df columns   names
        print df test exp 02 spread func index  f 2   tresample $ask index  - $bid index    1min    last expr sum buy ask 1  
         
        mid func index  f 2   tresample  $ask index    $bid index   2   1min    last expr sum buy ask 1  
         

        exprs     
        names range 1  11  
            exprs extend  spread func mid func names extend  f p spread f p mid df   d features stocks list  fields exprs  freq  ticks  
        df columns   names
        print df test exp 03 expr3 func1 name  index left  index right  f 2   tresample abs $ name  index left  - $ name  index right     1min    last expr sum buy ask 1 name ask    bid range 1  10  
                exprs    expr3 func1 name 1 names    f p diff  name i 1   
        exprs extend  expr3 func1  ask   10  1   expr3 func1  bid   1  10   
        names extend   p diff ask 10 1    p diff bid 1 10   
        df   d features stocks list  fields exprs  freq  ticks  
        df columns   names
        print df test exp 04 exprs     
        names name asize    bsize   
            exprs append f total func name   mean       10 total volume   
            names append f v avg  name   

        df   d features stocks list  fields exprs  freq  ticks  
        df columns   names
        print df test exp 05 exprs    
            f 2   sub total func  ask    last total func  bid    last expr sum buy ask 1   
            f sub total func  asize    mean total func  bsize    mean total volume   
         
        names     p accspread    v accspread  

        df   d features stocks list  fields exprs  freq  ticks  
        df columns   names
        print df test exp 06 t   3
        expr6 price func name  index  method  f 2    tresample $ name  index     t s     method    - ref tresample $ name  index     t s     method     1      t  
         
        exprs     
        names range 1  11 name bid    ask   
                exprs append 
                    f tresample  expr6 price func name last      1min    mean expr sum buy ask 1  
                 
                names append f p diff  name t s range 1  11 name asize    bsize   
                exprs append f tresample  expr6 price func name mean      1min    mean total volume   
                names append f v diff  name t s  

        df   d features stocks list  fields exprs  freq  ticks  
        df columns   names
        print df 

     
     
     
     
     
     
     

     staticmethod expr7 init funccode  ordercode  time interval f rolling eq $function code    ord funccode      eq $order kind   ord ordercode       time interval s    sum     rolling $function code    time interval s    count test exp 07 1 expr7 3 funccode  code  time interval  f tresample rolling eq $function code    ord funccode       code  $ask order  $bid order      time interval s    sum       rolling $function code    time interval s    count      1min    mean   
         

        exprs    expr7 3  c    gt    3    expr7 3  c    lt    3   
        names     ca intensity 3s    cb intensity 3s  

        df   d features stocks list  fields exprs  freq  transaction  
        df columns   names
        print df 

    trans dict     b s    b    0    l    1    m test exp 07 2 expr7 funccode  ordercode  time interval  f tresample expr7 init funccode  ordercode  time interval     1min    mean   
         

        exprs     
