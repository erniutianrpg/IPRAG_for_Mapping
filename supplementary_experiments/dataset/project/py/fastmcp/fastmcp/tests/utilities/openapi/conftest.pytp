 pytest fixture complex spec openapi    3 0 0  
         info     title    complex api    version    1 0 0   
         paths    
              items  id     
                 patch    
                     operationid    update item  
                     parameters    
                         
                             name    id path  
                             required schema     type    string   
                          
                         
                             name    version query  
                             required schema     type    integer    default   1  
                          
                         
                             name    x-client-version header  
                             required schema     type    string   
                          
                      
                     requestbody    
                         required content    
                             application json    
                                 schema    
                                     type    object  
                                     properties    
                                         title     type    string   
                                         description     type    string   
                                         tags    
                                             type    array  
                                             items     type    string   
                                          
                                      
                                     required     title   
                                 
                             
                          
                      
                     responses     200     description    item updated    
                 
             
          
     
