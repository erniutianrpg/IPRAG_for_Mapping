    parser   argparse argumentparser 
        prog  fastmcp-remote  
        description  bridge remote mcp server local stdio mcp process   
     
    parser add argument  url   help  remote mcp server url   
    parser add argument 
         callback port  
        nargs  ?  
        type int 
        help  oauth callback port  defaults available local port   
     
    parser add argument 
         --transport  
        choices   http    sse   
        default  http  
        help  remote transport  defaults http   
     
    parser add argument 
         --header  
        action  append  
        default    
        type parse header 
        help  header send upstream name  value  form  repeat multiple headers   
     
    parser add argument 
         --auth  
        choices   oauth default help  authentication mode  defaults oauth unless authorization provided   
     
    parser add argument 
         --resource  
        help  resource identifier used isolate oauth token storage   
     
    parser add argument 
         --host  
        default  localhost  
        help  oauth callback hostname  defaults localhost   
     
    parser add argument 
         --auth-timeout  
        type float 
        default 300 0 
        help  seconds wait oauth callback  defaults 300   
     
    parser add argument 
         --ignore-tool  
        action  append  
        default    
        help  hide tools matching glob pattern  repeat multiple patterns   
     
    parser add argument 
         --verify  
        type parse verify 
        default metavar  verify  
        help  
             ssl certificate verification path ca bundle file disable verification  insecure signed  
             certificates   defaults verification enabled  
          
     
    parser add argument 
         --debug  
        action  store help  enable debug logging   
     
