 bgslibrary 
  
  videoanalysis  videoanalysis     
    use file use camera cameraindex 0   
    use comp frametostop 0  
    
    debug construction videoanalysis   
    
 
  videoanalysis   videoanalysis     
    debug destruction videoanalysis videoanalysis  setup argc argv flag keys   
        hp help print message   
        uf use file use video file   
        fn filename  specify video file   
        uc use cam use camera   
        ca camera 0 specify camera index   
        co use comp use mask comparator   
        st stopat 0 frame number stop   
        im imgref  specify image file std  string keys   
        h help               print message      
        uf use file use video file        
        fn filename          specify video file    
        uc use cam use webcamera         
        ca camera      0     specify camera index    
        co use comp use mask comparator     
        st stopat      0     frame number stop    
        im imgref            specify image file    
        
  
 
    cv  commandlineparser cmd argc  argv  keys argc    1    cmd help std  cout     usage       argv 0        options      std  endl  
      std  cout     available options      std  endl  
      cmd printparams argc    1    cmd help    
      
      std  cout     usage       argv 0        options      std  endl  
      std  cout     available options      std  endl  
      cmd printmessage cmd check    
      
      cmd printerrors use file   cmd uf      
    filename   cmd std  string   fn      
    use camera   cmd uc      
    cameraindex   cmd ca      
    use comp   cmd co      
    frametostop   cmd st      
    imgref   cmd std  string   im      
 
    std  cout     use file          use file    std  endl  
    std  cout     filename          filename    std  endl  
    std  cout     use camera        use camera    std  endl  
    std  cout     cameraindex       cameraindex    std  endl  
    std  cout     use comp          use comp    std  endl  
    std  cout     frametostop       frametostop    std  endl  
    std  cout     imgref            imgref    std  endl use file filename empty      
        std  cout     specify filename     std  endl flag use camera  
      flag flag    use comp imgref empty      
        std  cout     specify image reference     std  endl return flag videoanalysis  start videocapture   std  make unique videocapture     
      frameprocessor   std  make shared frameprocessor     
 
      frameprocessor- init    
      frameprocessor- frametostop   frametostop  
      frameprocessor- imgref   imgref  
 
      videocapture- setframeprocessor frameprocessor use file  
        videocapture- setvideo filename use camera  
        videocapture- setcamera cameraindex   
 
      videocapture- start use file    use camera frameprocessor- finish key   cv  waitkey 500 key    key esc 1   
    
   bgslibrary videoanalysis