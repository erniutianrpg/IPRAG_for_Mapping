test f structuredheadersutilitiestest  testisvalididentifierallowed    
  expect isvalididentifier expect isvalididentifier 0-       
  expect isvalididentifier  abc   xyz     
  
 
test f structuredheadersutilitiestest  testisvalididentifierdisallowed    
  expect isvalididentifier  aaaa     
  expect isvalididentifier   aa     
  expect isvalididentifier  0abc     
  expect isvalididentifier       
  
 
test f structuredheadersutilitiestest  testisvalidstringallowed    
  expect isvalidstring cat      
  expect isvalidstring        ^^  g     
  expect isvalidstring               
  expect isvalidstring       
  
 
test f structuredheadersutilitiestest  testisvalidstringdisallowed    
  expect isvalidstring tcat      
  expect isvalidstring   x10 aaaaaaa     
  expect isvalidstring  chocolate x11     
  expect isvalidstring  pota nto     
  
 
test f structuredheadersutilitiestest  testgoodbinarycontent    
  expect isvalidencodedbinarycontent  agvsbg8      
  expect isvalidencodedbinarycontent  zgzzzgzmc2rm     
  expect isvalidencodedbinarycontent  za       
  
 
test f structuredheadersutilitiestest  testbadbinarycontent    
  expect isvalidencodedbinarycontent  agvsbg8     
  expect isvalidencodedbinarycontent  agvsb g8      
  expect isvalidencodedbinarycontent  agvsbg 8      
  expect isvalidencodedbinarycontent   agvsbg8     
  
 
test f structuredheadersutilitiestest  testitemtypematchescontentgood    
  structuredheaderitem item  
  item value   std  string    potato      
  item tag   structuredheaderitem  type  string  
  expect itemtypematchescontent item    
 
  item value   std  string 800    
  item tag   structuredheaderitem  type  identifier  
  expect itemtypematchescontent item    
 
  item tag   structuredheaderitem  type  none  
  expect itemtypematchescontent item    
 
  item value   std  string  hello    
  item tag   structuredheaderitem  type  binarycontent  
  expect itemtypematchescontent item    
 
  item value   int64 t 88   
  item tag   structuredheaderitem  type  int64  
  expect itemtypematchescontent item    
 
  item value 88 8   
  item tag   structuredheaderitem  type expect itemtypematchescontent item    
  
 
test f structuredheadersutilitiestest  testitemtypematchescontentbad    
  structuredheaderitem item  
 
  item value   std  string  hello    
  item tag   structuredheaderitem  type expect itemtypematchescontent item    
  item tag   structuredheaderitem  type  int64  
  expect itemtypematchescontent item    
 
  item value   int64 t 68   
  item tag   structuredheaderitem  type expect itemtypematchescontent item    
  item tag   structuredheaderitem  type  string  
  expect itemtypematchescontent item    
  item tag   structuredheaderitem  type  binarycontent  
  expect itemtypematchescontent item    
  item tag   structuredheaderitem  type  identifier  
  expect itemtypematchescontent item    
 
  item value 68 8   
  item tag   structuredheaderitem  type  int64  
  expect itemtypematchescontent item    
  item tag   structuredheaderitem  type  identifier  
  expect itemtypematchescontent item    
  item tag   structuredheaderitem  type  string  
  expect itemtypematchescontent item    
  item tag   structuredheaderitem  type  binarycontent  
  expect itemtypematchescontent item    
  
 
