 proxygen  coro  test testhttpchainhandler httpchainhandler testhttpchainhandler testhttpchainhandler   override folly  coro  task httpsourceholder  handlerequest  
      folly  eventbase  evb  
      httpsessioncontextptr ctx  
      httpsourceholder requestsource  override   
    co httpsourceholder    
    
   
 
test httphandlerchaintests  getnexthandlerempty    
  testhttpchainhandler handler  
  expect handler getnexthandler     
  
 
test httphandlerchaintests  setnexthandler    
  testhttpchainhandler handlera handlerb   std  make shared testhttpchainhandler     
 
  handlera setnexthandler handlerb   
  expect eq handlera getnexthandler    handlerb   
 
  handlera setnexthandler expect handlera getnexthandler     
  
 
test httphandlerchaintests  getfrontempty    
  httphandlerchain chain  
  expect chain getfront     
  
 
test httphandlerchaintests  getbackempty    
  httphandlerchain chain  
  expect chain getback     
  
 
test httphandlerchaintests  getfrontnonempty    
  httphandlerchain chainfront  
  chainfront insertfront std  make shared testhttpchainhandler      
  expect chainfront getfront     
 
  httphandlerchain chainback  
  chainback insertback std  make shared testhttpchainhandler      
  expect chainback getfront     
  
 
test httphandlerchaintests  getbacknonempty    
  httphandlerchain chainfront  
  chainfront insertfront std  make shared testhttpchainhandler      
  expect chainfront getfront     
 
  httphandlerchain chainback  
  chainback insertback std  make shared testhttpchainhandler      
  expect chainback getfront     
  
 
test httphandlerchaintests  insertfrontmultiple    
  httphandlerchain chain chainhandlera   std  make shared testhttpchainhandler chainhandlerb   std  make shared testhttpchainhandler chainhandlerc   std  make shared testhttpchainhandler     
 
  chain insertfront chainhandlera   
  chain insertfront chainhandlerb   
  chain insertfront chainhandlerc   
 
    
  expect eq chain getfront    chainhandlerc   
  expect eq chain getback    chainhandlera   
 
    
  expect eq chainhandlerc- getnexthandler    chainhandlerb   
  expect eq chainhandlerb- getnexthandler    chainhandlera   
  expect chainhandlera- getnexthandler     
  
 
test httphandlerchaintests  insertbackmultiple    
  httphandlerchain chain chainhandlera   std  make shared testhttpchainhandler chainhandlerb   std  make shared testhttpchainhandler chainhandlerc   std  make shared testhttpchainhandler     
 
  chain insertback chainhandlera   
  chain insertback chainhandlerb   
  chain insertback chainhandlerc   
 
    
  expect eq chain getfront    chainhandlera   
  expect eq chain getback    chainhandlerc   
 
    
  expect eq chainhandlera- getnexthandler    chainhandlerb   
  expect eq chainhandlerb- getnexthandler    chainhandlerc   
  expect chainhandlerc- getnexthandler     
  
 
test httphandlerchaintests  insertmultiple    
  httphandlerchain chain chainhandlera   std  make shared testhttpchainhandler chainhandlerb   std  make shared testhttpchainhandler chainhandlerc   std  make shared testhttpchainhandler chainhandlerd   std  make shared testhttpchainhandler     
 
  chain insertfront chainhandlera   
  chain insertback chainhandlerb   
  chain insertfront chainhandlerc   
  chain insertback chainhandlerd   
 
    
  expect eq chain getfront    chainhandlerc   
  expect eq chain getback    chainhandlerd   
 
    
  expect eq chainhandlerc- getnexthandler    chainhandlera   
  expect eq chainhandlera- getnexthandler    chainhandlerb   
  expect eq chainhandlerb- getnexthandler    chainhandlerd   
  expect chainhandlerd- getnexthandler     
  
 
test httphandlerchaintests  insertfrontnull    
  httphandlerchain chain chainhandler   std  make shared testhttpchainhandler     
  chain insertfront chainhandler   
  chain insertfront expect eq chain getfront    chainhandler   
  expect eq chain getback    chainhandler   
  
 
test httphandlerchaintests  insertbacknull    
  httphandlerchain chain chainhandler   std  make shared testhttpchainhandler     
  chain insertback chainhandler   
  chain insertback expect eq chain getfront    chainhandler   
  expect eq chain getback    chainhandler   
  
 
     proxygen lib http coro test httphandlerchaintests