 folly proxygen std loggingtests testing  test     
 
test f loggingtests  printhexiobuf    
  unique ptr iobuf  buf   iobuf  create 128   
  expect eq iobufprinter  printhexfolly buf expect eq iobufprinter  printhex16 buf uint8 t  data   buf- writabledata    
  data 0    0x0c  
  data 1    0xff  
  data 2    0x00  
  data 3    0x10  
  buf- append 4   
  expect iobufprinter  printhexfolly buf expect eq iobufprinter  printhex16 buf 0cff 0010 0 16 data 4 0xfe  
    
  buf- append 16   
  expect iobufprinter  printhexfolly buf string info   iobufprinter  printchaininfo buf expect info find  iobuf size 20 tailroom       string  npos   
  expect eq iobufprinter  printhex16 buf 0cff 0010 fefe fefe fefe fefe fefe fefe  nfefe fefe     
  
 
test f loggingtests  hexstring    
  uint8 t buf      0x03  0x04  0x11  0x22  0xbb  0xaa   
  string s buf buf    
  expect eq  03041122bbaa   hexstr s    
  
 
test f loggingtests  dumpbin    
    
  expect eq iobufprinter  printbin unique ptr iobuf  b1   iobuf  create 128   
  b1- writabledata   0    0x33  
  b1- writabledata   1    0x77  
  b1- append 2   
  unique ptr iobuf  b2   iobuf  create 128   
  b2- writabledata   0    0xff  
  b2- append 1   
  b1- appendchain std  move b2    
  expect eq iobufprinter  printbin b1 00110011 3 01110111 w  n11111111    n    
    
  expect eq iobufprinter  printbin b1 00110011 3 01110111 w 11111111    n    
  
 
test f loggingtests  dumpbintofile stat fstat tmpfile folly string    tmp test    getpid      bin     
 
  unlink tmpfile c str     
  unique ptr iobuf  buf   iobuf  create 128   
    
  buf- append 2   
  dumpbintofile tmpfile  buf expect eq stat tmpfile c str     fstat   0   
 
    
  buf- append 4   
  dumpbintofile tmpfile  buf expect eq stat tmpfile c str     fstat   0   
  expect eq fstat st size  2   
  unlink tmpfile c str     
 
    
  dumpbintofile tmpfile dumpbintofile   proc test   proxygen lib utils test loggingtests