test f headertabletests  addlargerthantable    
    
  uint32 t capacitybytes   256  
  headertable table capacitybytes   
  hpackheadername name  accept-encoding    
  table add hpackheader  accept-encoding    gzip       
  table add hpackheader  accept-encoding    gzip       
  table add hpackheader  test-encoding    gzip         
  expect eq table names   size    2   
 
    
    
  table add hpackheader std  string capacitybytes gzip     
  expect eq table names   size    0   
 
    
  table add hpackheader  accept-encoding    gzip       
  table add hpackheader  accept-encoding    gzip       
  table add hpackheader  test-encoding    gzip         
  expect eq table names   size    2   
 
  expect eq table hasname name table names   find name   
  expect eq second size    2   
    
    
    
  expect eq table nameindex name   2   
  
 
test f headertabletests  increaselengthoffulltable    
  hpackheader largeheader  access-control-allow-credentials hpackheader smallheader  accept content    
 
  headertable table 448   
  check eq table length    7 uint8 t count   0  count   3  count      
    table add largeheader copy     
    table add smallheader copy     
      
  check eq table length    7   
 
  table add smallheader copy     
  table add smallheader copy       
  table add smallheader copy       
  expect eq table length    11   
 
    
  check eq table getheader 1   smallheader   
  check eq table getheader 2   smallheader   
  check eq table getheader 3   smallheader   
  check eq table getheader 4   smallheader   
  check eq table getheader 5   largeheader   
  check eq table getheader 6   smallheader   
  check eq table getheader 7   largeheader   
  check eq table getheader 8   smallheader   
  
 
test f headertabletests  smalltable    
  headertable table 80   
  hpackheader foo  foo    bar    
  expect table add foo copy      
  expect table add foo copy      
  expect eq table size    2   
  expect eq table length    2   
  
 
test f headertabletests  tinytable    
    
  headertable table 63   
  hpackheader foo  foo    barbarbarbarbarbarbar1    
  expect table add foo copy      
  expect eq table size    1   
  expect eq table length    1   
  
 
