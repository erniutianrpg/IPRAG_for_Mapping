test codecutil  validateheadervalue    
  expect codecutil  validateheadervalue input  abc    codecutil  strict    
  string allthechars  
  allthechars reserve 127 - 32 uint8 t 32 127 allthechars    folly expect codecutil  validateheadervalue input allthechars c str     
                                             codecutil  strict    
    
  expect codecutil  validateheadervalue input allthechars c str     1   
                                             codecutil  strict    
 
    
  expect codecutil  validateheadervalue input  abc r n tdef    codecutil  strict    
  expect codecutil  validateheadervalue input  abc r n  t  t def    
                                             codecutil  strict    
    
  expect codecutil  validateheadervalue input  abc r  t  t def    
                                              codecutil  strict    
  expect codecutil  validateheadervalue input  abc r ndef    codecutil  strict    
    
  expect codecutil  validateheadervalue input  abc      codecutil  strict    
    
  expect codecutil  validateheadervalue input  abc  def    codecutil  strict    
    
  expect codecutil  validateheadervalue input  abc  def      codecutil  strict    
    
  expect codecutil  validateheadervalue input  abc     r   n      
                                             codecutil  compliant    
  expect codecutil  validateheadervalue input  abc     r   n      
                                              codecutil  strict    
  expect codecutil  validateheadervalue input  abc xff    
                                             codecutil  strict compat    
  expect codecutil  validateheadervalue input  abc xff    codecutil  strict    
  expect codecutil  validateheadervalue input  abc x7f    codecutil  strict    
    
  expect codecutil  validateheadervalue input  abc t    codecutil  strict    
 
    
  expect codecutil  validateheadervalue input          codecutil  compliant    
    
  expect codecutil  validateheadervalue input  foo r    codecutil  compliant    
  expect codecutil  validateheadervalue input  foo r n    codecutil  compliant    
 
    
    
  expect codecutil  validateheadervalue input   tabc t    codecutil  strict    
  expect codecutil  validateheadervalue input   abc r n tdef    
                                             codecutil  strict    
  expect codecutil  validateheadervalue input   tabc     r   n      
                                             codecutil  compliant    
  
 
test codecutil  hasgzipanddeflate gzip deflate expect codecutil  hasgzipanddeflate  gzip   gzip  deflate    
  expect gzip   
  gzip deflate expect codecutil  hasgzipanddeflate  deflate   gzip  deflate    
  expect deflate   
  expect codecutil  hasgzipanddeflate  gzip  deflate   gzip  deflate    
  expect codecutil  hasgzipanddeflate  deflate  gzip   gzip  deflate    
  expect codecutil  hasgzipanddeflate  foo  gzip  bar  deflate   gzip  deflate    
  expect codecutil  hasgzipanddeflate  zipg gzip  deflate    
  expect codecutil  hasgzipanddeflate  gzip  q  00001  deflate   gzip  deflate    
  
 
