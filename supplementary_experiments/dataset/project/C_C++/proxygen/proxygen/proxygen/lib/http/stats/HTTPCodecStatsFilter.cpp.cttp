  callback - onwindowupdate stream  amount httpcodecstatsfilter  onsettings settingslist  settings    
  counters - recordingresssettings    
  callback - onsettings settings httpcodecstatsfilter  onsettingsack     
  counters - recordingresssettings    
  callback - onsettingsack httpcodecstatsfilter  onpriority streamid stream httppriority  priority    
