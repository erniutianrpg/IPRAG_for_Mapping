 proxygen  sampling std  string  
 
test samplingtests  basic    
  sampling rate 1 0   
  expect eq rate islucky expect eq rate getweight    1   
 
  rate   sampling 0 0   
  expect eq rate islucky expect eq rate getweight    0   
 
  rate   sampling 0 5   
  expect eq rate getweight    2   
 
  rate   sampling 0 00001   
  expect eq rate getweight    100000   
 
  rate   sampling 0 000001   
  expect eq rate getweight    1000000   
 
    
  rate   sampling 0 000000000001   
  expect eq rate getweight    0   
  
 
test samplingtests  updaterate    
  sampling sampling 0 5   
  expect eq sampling getweight    2   
  sampling updaterate 0 05   
  expect eq sampling getweight    20   
  
 
test samplingtests  key    
  sampling sampling 1 0   
  expect eq sampling getintrate    std  numeric limits uint32 t   max     
  sampling updaterate 0   
  expect eq sampling getintrate    0   
  sampling updaterate 0 5   
  expect eq sampling getintrate    std  numeric limits uint32 t   max     2   
  
 
test samplingtests  hashkey    
  sampling sampling 1 0   
  string key    test   
  expect sampling islucky key    
  sampling updaterate 0 0   
  expect sampling islucky key    
  sampling updaterate 0 5   
  expect sampling islucky key    
    
  expect sampling islucky key    
  
 
test samplingtests  runsampled counter   0  
 
    sampling sampling 1 0 0 3 sampling runsampled         counter      
      
    expect eq counter  3 counter   0  
    sampling sampling 0 0 3 sampling runsampled         counter      
      
    expect eq counter  0 counter   0  
    sampling sampling 0 5 0 100 sampling runsampled         counter      
      
    expect gt counter  0   
    expect lt counter  100   
    
   proxygen lib sampling test samplingtest