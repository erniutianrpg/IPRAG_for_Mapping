test f defaultflowcontrol  flowcontrolconstruct    
    
    
    
  insequence enforcesequence  
  assert eq writebuf  chainlength    0   
 
    
  chain - generatebody  
      writebuf   1  makebuf kinitialcapacity - 1   httpcodec  nopadding callbackstart - onwindowupdate 0  1   
 
    
  expect call flowcallback   onconnectionsendwindowclosed     
  chain - generatebody writebuf   1  makebuf 2   httpcodec  nopadding expect call flowcallback   onconnectionsendwindowopen     
  callbackstart - onwindowupdate 0  1   
 
    
  expect death core  
      chain - generatebody  
          writebuf   1  makebuf 2   httpcodec  nopadding test f defaultflowcontrol  sendupdate    
    
  insequence enforcesequence  
  expect call callback   onbody           willrepeatedly callbackstart - onbody 1  makebuf kinitialcapacity   2   1   0   
  filter - ingressbytesprocessed writebuf   kinitialcapacity   2   
 
    
  expect call  codec   generatewindowupdate    0  kinitialcapacity   2   1    
  filter - ingressbytesprocessed writebuf   1   
  
 
test f bigwindow  recvtoomuch    
    
    
  assert gt writebuf  chainlength    0   
 
  insequence enforcesequence  
  expect call callback   onbody            
  expect call callback   onerror 0  isflowexception        
       willonce invoke    httpcodec  streamid  
                          std  shared ptr httpexception  exc assert eq  
             failed reserve receive window  window size 0    
             amount 1   
            std  string exc callbackstart - onbody 1  makebuf recvwindow    0   
  assert chain - isreusable     
    
  callbackstart - onbody 1  makebuf 1   0   
  assert chain - isreusable     
  
 
test f bigwindow  remoteincrease    
    
    
  insequence enforcesequence  
 
  assert eq filter - getavailablesend    kinitialcapacity   
  callbackstart - onwindowupdate 0  10   
  assert eq filter - getavailablesend    kinitialcapacity   10   
 
  expect call flowcallback   onconnectionsendwindowclosed     
  chain - generatebody writebuf   
                       1  
                       makebuf kinitialcapacity   10   
                       httpcodec  nopadding assert eq filter - getavailablesend    0   
 
    
    
    
  expect call flowcallback   onconnectionsendwindowopen     
  callbackstart - onwindowupdate 0  std  numeric limits int32 t   max     
  assert eq filter - getavailablesend    std  numeric limits int32 t   max     
 
    
  expect call callback   onerror 0  isflowexception        
       willonce invoke    httpcodec  streamid  
                          std  shared ptr httpexception  exc assert eq  
             failed update send window  outstanding 0    
             amount 1   
            std  string exc callbackstart - onwindowupdate 0  1   
  assert chain - isreusable     
  
 
test f httpcheckstest  sendtracebodydeath    
    
 
  httpmessage msg   getpostrequest    
  msg setmethod  trace    
 
  expect death core chain - generateheader writebuf   0  msg          
  
 
test f httpcheckstest  sendgetbody    
    
    
 
  expect call  codec   generateheader                     
 
  httpmessage msg   getpostrequest    
  msg setmethod chain - generateheader writebuf   0  msg   
  
 
test f httpcheckstest  recvtracebody    
    
 
  expect call callback   onerror           
       willonce invoke    httpcodec  streamid  
                          std  shared ptr httpexception  exc newtxn    
        assert newtxn   
        assert eq exc- gethttpstatuscode    400   
        assert eq 0  strcmp  rfc2616  request body allowed   exc msg   makepostrequest    
  msg- setmethod  trace    
 
  callbackstart - onheaderscomplete 0  std  move msg    
  
 
test f debugfiltertest  noerror    
  chain - oningress  makeiobuf  foo     
  chain - oningresseof    
  callbackstart - onmessagebegin 1 callbackstart - onheaderscomplete 1  makegetrequest     
  callbackstart - onmessagecomplete 1 expect dumpedingress  empty     
  
 
test f debugfiltertest  noerrorgoaway    
  chain - oningress  makeiobuf  foo     
  callbackstart - ongoaway 0  errorcode makeiobuf  bar     
  expect dumpedingress  empty     
  
 
test f debugfiltertest  ingressgoaway    
  chain - oningress  makeiobuf  foo     
  callbackstart - ongoaway 0  errorcode  protocol makeiobuf  bar     
  expect eq dumpedingress  move  - movetofbstring    std  string  foo     
  
 
test f debugfiltertest  egressgoaway    
  chain - oningress  makeiobuf  foo     
  chain - generategoaway  
      writebuf   0  errorcode  protocol makeiobuf  bar     
  expect eq dumpedingress  move  - movetofbstring    std  string  foo     
  
 
