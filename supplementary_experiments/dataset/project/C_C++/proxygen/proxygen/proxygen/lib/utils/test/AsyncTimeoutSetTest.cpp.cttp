mocktimeoutclock  testtimeout  clock timeouttest testing  test setup   override   
    testtimeout  settimeoutclock timeoutclock    
    setclock milliseconds 0    
 
    expect call timeoutmanager   attachtimeoutmanager        
         willrepeatedly expect call timeoutmanager   scheduletimeout        
         willrepeatedly invoke asynctimeout  p  milliseconds t    
          timeoutmanager  canceltimeout p   
          folly  event ref flags p- getevent  - getevent       evlist timeout  
          timeouts  emplace t   timeoutclock  millisecondssinceepoch    p expect call timeoutmanager   canceltimeout     
         willrepeatedly invoke asynctimeout  p timeouts  begin timeouts  end it- second    p    
              timeouts  erase loop t   timeoutclock  millisecondssinceepoch     milliseconds 1   
          timeouts  empty    
         t      
      setclock t setclock milliseconds ms    
    expect call timeoutclock   millisecondssinceepoch    
         willrepeatedly ms timeouts  empty      
           timeoutclock  millisecondssinceepoch      timeouts  begin  - first    
      asynctimeout  timeout   timeouts  begin  - second  
      timeouts  erase timeouts  begin     
      folly  event ref flags timeout- getevent  - getevent       
           evlist timeout  
      timeout- timeoutexpired mocktimeoutmanager timeoutmanager   
  mocktimeoutclock timeoutclock   
  std  multimap milliseconds  asynctimeout   timeouts   
   
 
 
 
test f timeouttest  fireonce    
  stacktimeoutset ts10  
       timeoutmanager   milliseconds 10   milliseconds 0    timeoutclock    
  stacktimeoutset ts5  
       timeoutmanager   milliseconds 5   milliseconds 0    timeoutclock asynctimeoutset  callback  nullcallback assert eq ts10 front    nullcallback   
  assert eq ts5 front    nullcallback   
 
  testtimeout t1  
  testtimeout t2  
  testtimeout t3  
 
  ts5 scheduletimeout  t1     
 
    
    
 
  setclock milliseconds 2    
 
  ts5 scheduletimeout  t2   
  ts10 scheduletimeout  t3   
 
  assert eq ts10 front     t3   
  assert eq ts5 front     t1   
 
  setclock milliseconds 5    
  assert eq ts5 front     t2   
 
  setclock milliseconds 7    
  assert eq ts5 front    nullcallback   
 
  assert eq t1 timestamps size    1   
  assert eq t2 timestamps size    1   
 
  setclock milliseconds 12    
 
  assert eq t3 timestamps size    1   
 
  assert eq ts10 front    nullcallback   
 
  assert eq t1 timestamps 0   milliseconds 5    
  assert eq t2 timestamps 0   milliseconds 7    
  assert eq t3 timestamps 0   milliseconds 12    
  
 
 
 
test f timeouttest  switchtimeoutset    
  stacktimeoutset ts10  
       timeoutmanager   milliseconds 10   milliseconds 0    timeoutclock    
  stacktimeoutset ts5  
       timeoutmanager   milliseconds 5   milliseconds 0    timeoutclock    
 
  testtimeout t1  ts5   ts10   ts5   
  testtimeout t2  ts10   ts10   ts5   
  testtimeout t3  ts5   ts5   ts10   ts5   
 
  ts5 scheduletimeout  t1   
 
  loop    
 
  assert eq t1 timestamps size    3   
  assert eq t2 timestamps size    3   
  assert eq t3 timestamps size    4   
 
  assert eq t1 timestamps 0   milliseconds 5    
  assert eq t1 timestamps 1  - t1 timestamps 0   milliseconds 10    
  assert eq t1 timestamps 2  - t1 timestamps 1   milliseconds 5    
 
  assert eq t2 timestamps 0   milliseconds 10    
  assert eq t2 timestamps 1  - t2 timestamps 0   milliseconds 10    
  assert eq t2 timestamps 2  - t2 timestamps 1   milliseconds 5    
 
  assert eq t3 timestamps 0   milliseconds 5    
  assert eq t3 timestamps 1  - t3 timestamps 0   milliseconds 5    
  assert eq t3 timestamps 2  - t3 timestamps 1   milliseconds 10    
  assert eq t3 timestamps 3  - t3 timestamps 2   milliseconds 5    
  assert eq timeoutclock  millisecondssinceepoch    milliseconds 25    
  
 
 
 
test f timeouttest  canceltimeout    
  stacktimeoutset ts5  
       timeoutmanager   milliseconds 5   milliseconds 0    timeoutclock    
  stacktimeoutset ts10  
       timeoutmanager   milliseconds 10   milliseconds 0    timeoutclock    
  stacktimeoutset ts20  
       timeoutmanager   milliseconds 20   milliseconds 0    timeoutclock    
 
    
  testtimeout t5 1  ts5   
  testtimeout t5 2  ts5   
  testtimeout t5 3  ts5   
  testtimeout t5 4  ts5   
  testtimeout t5 5  ts5   
 
    
  testtimeout t10 1  ts10   
  testtimeout t10 2  ts10   
  testtimeout t10 3  ts10   
 
  testtimeout t20 1  ts20   
  testtimeout t20 2  ts20   
 
    
    
    
    
    
    
  t5 1 fn         
    t5 2 canceltimeout    
    t5 4 canceltimeout    
     
 
    
    
    
    
  t5 3 fn         
    t5 5 canceltimeout fn   std  move t5 3 fn   
    ts5 scheduletimeout  t5 3   
 
      
      
      
      
    t10 2 canceltimeout    
      
    t20 1 canceltimeout    
    t20 2 canceltimeout    
     
 
  loop    
 
  assert eq t5 1 timestamps size    1   
  assert eq t5 1 timestamps 0   milliseconds 5    
 
  assert eq t5 3 timestamps size    2   
  assert eq t5 3 timestamps 0   milliseconds 5    
  assert eq t5 3 timestamps 1  - t5 3 timestamps 0   milliseconds 5    
 
  assert eq t10 1 timestamps size    1   
  assert eq t10 1 timestamps 0   milliseconds 10    
 
  assert eq t10 3 timestamps size    1   
  assert eq t10 3 timestamps 0   milliseconds 10    
 
    
  assert eq t5 2 timestamps size    0   
  assert eq t5 4 timestamps size    0   
  assert eq t5 5 timestamps size    0   
  assert eq t10 2 timestamps size    0   
  assert eq t20 1 timestamps size    0   
  assert eq t20 2 timestamps size    0   
  assert eq timeoutclock  millisecondssinceepoch    milliseconds 10    
  
 
 
 
test f timeouttest  destroytimeoutset    
  asynctimeoutset  uniqueptr ts5 asynctimeoutset  
       timeoutmanager   milliseconds 5   milliseconds 0    timeoutclock     
  asynctimeoutset  uniqueptr ts10 asynctimeoutset  
       timeoutmanager   milliseconds 10   milliseconds 0    timeoutclock     
 
  testtimeout t5 1 ts5 testtimeout t5 2 ts5 testtimeout t5 3 ts5 testtimeout t10 1 ts10 testtimeout t10 2 ts10 t5 1 fn         ts10 reset       
    
    
    
  t5 2 fn         ts5 reset       
 
  loop    
 
  assert eq t5 1 timestamps size    1   
  assert eq t5 1 timestamps 0   milliseconds 5    
  assert eq t5 2 timestamps size    1   
  assert eq t5 2 timestamps 0   milliseconds 5    
 
  assert eq t5 3 timestamps size    0   
  assert eq t10 1 timestamps size    0   
  assert eq t10 2 timestamps size    0   
  assert eq timeoutclock  millisecondssinceepoch    milliseconds 5    
  
 
 
 
test f timeouttest  atmosteveryn    
    
    
  milliseconds interval 25   
  milliseconds atmosteveryn 6   
  stacktimeoutset ts25  
       timeoutmanager   interval  atmosteveryn   timeoutclock    
 
    
  uint32 t numtimeouts   60  
  std  vector testtimeout  timeouts numtimeouts uint32 t index   0  index   numtimeouts  index      
    setclock milliseconds index    
    timeouts index  timeoutexpired    
    ts25 scheduletimeout  timeouts index    
    
 
  loop uint32 t idx   0  idx   numtimeouts    idx    
    assert eq timeouts idx  timestamps size    2 scheduledtime   timeouts idx  timestamps 0    interval firedtime   timeouts idx  timestamps 1   
      
      
      
    milliseconds tolerance   atmosteveryn  
    assert ge firedtime  scheduledtime   
    assert lt firedtime  scheduledtime   tolerance idx    0 prev   timeouts idx - 1  timestamps 1 delta   firedtime - prev delta    milliseconds 1     
      assert ge delta  atmosteveryn   
      
    
  assert le timeoutclock  millisecondssinceepoch    
            milliseconds numtimeouts    interval   atmosteveryn   
   proxygen lib utils test asynctimeoutsettest