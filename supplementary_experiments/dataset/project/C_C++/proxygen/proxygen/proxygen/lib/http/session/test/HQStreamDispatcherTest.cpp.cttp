test f unidirectionalreaddispatchertest  testdispatchcontrolpreface    
 
  quic  streamid expectedid   5  
  uint8 t atleastbytes   4  
    
  dispatchercallback  expectparsepreface     uint64 t hq  unidirectionalstreamtype  control  
      
 
    
  dispatchercallback  expectassignreadcallback  
          quic  streamid id  
          hq  unidirectionalstreamtype    
          size t consumed    
        assert eq id  expectedid   
        assert eq consumed  atleastbytes   
          
 
    
    
  dispatcher  taketemporaryownership expectedid   
 
    
    
    
  senddata expectedid cast uint64 t  hq  unidirectionalstreamtype  control   
           atleastbytes   
  
 
