test f httpbinaryupstreamcodectest  indeterminatelenreqknownlengthresp    
  folly  iobufqueue upstreamegress  
  httpmessage req  
  req seturl       
  req getheaders   set  host    test com    
    
  binarycodecindeterminatelength - generateheader  
      upstreamegress   0  req   
  binarycodecindeterminatelength - generatebody  
      upstreamegress   0   makebuf 10 resp   folly  iobuf  fromstring folly  unhexlify  0140c800     
  fakehttpcodeccallback upstreamcodeccb  
  binarycodecindeterminatelength - setcallback  upstreamcodeccb   
  binarycodecindeterminatelength - oningress  resp   
  binarycodecindeterminatelength - oningresseof    
  expect eq upstreamcodeccb msg- getstatuscode    200   
 
    
  binarycodecindeterminatelength - generatebody  
      upstreamegress   0   makebuf 10    
    
  expect gt  
      binarycodecindeterminatelength - generateeom upstreamegress   0   
      0   
 
    
  httpbinarycodec downstreamcodec transportdirection  downstream   
  fakehttpcodeccallback downstreamcodeccb  
  downstreamcodec setcallback  downstreamcodeccb   
  downstreamcodec oningress  upstreamegress front     
  downstreamcodec oningresseof    
 
  expect eq downstreamcodeccb msg- geturl          
  expect eq downstreamcodeccb msg- getheaders   getsingleorempty  host    
             test com    
  expect downstreamcodeccb lastparseerror   
  
 
