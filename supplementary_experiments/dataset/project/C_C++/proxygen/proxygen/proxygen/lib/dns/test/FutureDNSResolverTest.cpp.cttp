test f futurednsresolvertest  testresolveaddresssuccess addr1   folly  socketaddress folly  ipaddress  1 2 3 4    0 answers1   resolver - resolveaddress addr1  getvia evb    
  expect eq 1  answers1 size     
  expect eq answertype name  answers1 0  type   
  expect eq  1234 com   answers1 0  name addr2   folly  socketaddress folly  ipaddress  2 3 4 5    0 answers2   resolver - resolveaddress addr2  getvia evb    
  expect eq 1  answers2 size     
  expect eq answertype name  answers2 0  type   
  expect eq  2345 com   answers2 0  name   
  
 
test f futurednsresolvertest  testresolveaddressfail addr   folly  socketaddress folly  ipaddress  6 7 8 9    0   
  expect resolver - resolveaddress addr  getvia evb       fakeresolvererror   
  
 
test f futurednsresolvertest  testresolvehostnamesuccess addr1   folly  socketaddress folly  ipaddress  1 2 3 4    0 answers1   resolver - resolvehostname  1234 com   getvia evb    
  expect eq 1  answers1 size     
  expect eq answertype address  answers1 0  type   
  expect eq addr1  answers1 0  address addr2   folly  socketaddress folly  ipaddress  2 3 4 5    0 answers2   resolver - resolvehostname  2345 com   getvia evb    
  expect eq 1  answers2 size     
  expect eq answertype address  answers2 0  type   
  expect eq addr2  answers2 0  address   
  
 
test f futurednsresolvertest  testresolvehostnamefail    
  expect resolver - resolvehostname  unknown-host com   getvia evb       
      fakeresolvererror   
  
 
test f futurednsresolvertest  testresolvemailexchangesuccess host11    mail1 1234 com priority11   10 host12    mail2 1234 com priority12   20 host13    mail3 1234 com priority13   30 answers1   resolver - resolvemailexchange  1234 com   getvia evb    
  expect eq 3  answers1 size     
  expect eq answertype mx  answers1 0  type   
  expect eq host11  answers1 0  name   
  expect eq priority11  answers1 0  priority   
  expect eq answertype mx  answers1 1  type   
  expect eq host12  answers1 1  name   
  expect eq priority12  answers1 1  priority   
  expect eq answertype mx  answers1 2  type   
  expect eq host13  answers1 2  name   
  expect eq priority13  answers1 2  priority host21    mailone 2345 com priority21   100 host22    mailtwo 2345 com priority22   100 answers2   resolver - resolvemailexchange  2345 com   getvia evb    
  expect eq 2  answers2 size     
  expect eq answertype mx  answers2 0  type   
  expect eq host21  answers2 0  name   
  expect eq priority21  answers2 0  priority   
  expect eq answertype mx  answers2 1  type   
  expect eq host22  answers2 1  name   
  expect eq priority22  answers2 1  priority   
  
 
test f futurednsresolvertest  testresolvemailexchangefail    
  expect resolver - resolvemailexchange  unknown-host com   getvia evb       
      fakeresolvererror   
  
