 proxygen httpcommonheaderstests testing  test     
 
test f httpcommonheaderstests  testhashing    
  std  string common1  content-length    
  std  string common2  content-length    
  std  string uncommon  uncommon    
 
  httpheadercode commoncode1   httpcommonheaders  hash common1   
  httpheadercode commoncode2   httpcommonheaders  hash common2   
  httpheadercode uncommoncode   httpcommonheaders  hash uncommon   
 
  expect eq uncommoncode  httpheadercode  http header expect ne commoncode1  httpheadercode  http header expect eq commoncode1  commoncode2   
  
 
test f httpcommonheaderstests  testtwotablesinitialized    
  std  string common  content-length    
  httpheadercode code   httpcommonheaders  hash common   
 
  expect eq  httpcommonheaders  getpointertoname code    content-length    
  expect eq  httpcommonheaders  getpointertoname  
                code  httpcommonheadertabletype  table lowercase   
             content-length    
  
 
test f httpcommonheaderstests  testiscommonheadernamefromtable    
    
  expect httpcommonheaders  isnamefromtable  
      httpcommonheaders  getpointertoname http header none   
      httpcommonheadertabletype  table camelcase    
  expect httpcommonheaders  isnamefromtable  
      httpcommonheaders  getpointertoname http header httpcommonheadertabletype  table camelcase httpcommonheaders  num codes   httpheadercodecommonoffset    
    expect httpcommonheaders  isnamefromtable  
        httpcommonheaders  getpointertoname cast httpheadercode  httpheadercodecommonoffset   1    
        httpcommonheadertabletype  table camelcase    
 
      
    expect httpcommonheaders  isnamefromtable  
        httpcommonheaders  getpointertoname cast httpheadercode  httpcommonheaders  num codes - 1    
        httpcommonheadertabletype  table camelcase    
    
 
    
    
  std  string externalheader    externalheader   
  expect httpcommonheaders  isnamefromtable  
       externalheader  httpcommonheadertabletype  table camelcase    
  
 
test f httpcommonheaderstests  testgetheadercodefromtablecommonheadername uint64 t j   httpheadercodecommonoffset  
       j   httpcommonheaders  num codes  
         j code cast httpheadercode  j   
    expect code    httpcommonheaders  getcodefromtablename  
                            httpcommonheaders  getpointertoname code   
                            httpcommonheadertabletype  table camelcase    
    
  std  string externalheader    externalheader   
  expect http header httpcommonheaders  getcodefromtablename  
                   externalheader  httpcommonheadertabletype  table camelcase    
   proxygen lib http test httpcommonheaderstests