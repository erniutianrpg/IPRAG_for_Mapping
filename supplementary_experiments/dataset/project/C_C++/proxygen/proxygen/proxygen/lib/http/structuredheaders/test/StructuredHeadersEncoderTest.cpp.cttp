test f structuredheadersencodertest  testlistmanyelts    
  std  vector structuredheaderitem  vec  
  structuredheaderitem item  
 
  item tag   structuredheaderitem  type double val1   3 14  
  item value   val1  
  vec push back item   
 
  item tag   structuredheaderitem  type  binarycontent  
  std  string val2    pizza   
  item value   val2  
  vec push back item   
 
  item tag   structuredheaderitem  type  int64  
  int64 t val3   65  
  item value   val3  
  vec push back item   
 
  structuredheadersencoder encoder err   encoder encodelist vec   
 
  expect eq err  encodeerror  ok   
  expect eq encoder 3 14   cgl6eme    65    
  
 
