  structuredheadersencoder encoder  
  structuredheaderitem item val   100000 8392758372647    
  item tag   structuredheaderitem  type item value   val err   encoder encodeitem item   
 
  expect eq err  encodeerror  ok   
  expect eq encoder 100000 839275837    
  
 
test f structuredheadersencodertest  testfloatnegative    
