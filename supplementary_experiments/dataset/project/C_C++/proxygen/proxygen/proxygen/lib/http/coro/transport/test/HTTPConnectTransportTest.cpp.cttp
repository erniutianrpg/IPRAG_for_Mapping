test f httpconnecttransporttest  connectsuccess    
  run       -  task cs   co await connect    
      
    expect eq  1 2 3 4   cs- getpeeraddress   getaddressstr     
    expect eq connecthandler- peeraddr  cs- getlocaladdress     
    expect eq cs- geteventbase     evb   
      
    expect eq cs- gettransport expect eq cs- getpeercertificate test f httpconnecttransporttest  connectnon200    
  connecthandler- expectexceptions    
  run       -  task connparams   httpcoroconnector  defaultconnectionparams    
    connparams plaintextprotocol    h2 session   co await httpcoroconnector  connect  
         evb   srv- address    0ms  connparams reservation   session- reserverequest    
    expect co await httpconnectstream  connectunique session  
                                                  std  move  reservation   
                                                  kauthority  
                                                  std  chrono  seconds 1   
                                                     fail std  runtime test f httpconnecttransporttest  connectslow    
  run       -  task connparams   httpcoroconnector  defaultconnectionparams    
    connparams plaintextprotocol    h2   
    httpcoroconnector  sessionparams sessparams  
    sessparams streamreadtimeout   std  chrono  milliseconds 100 session   co await httpcoroconnector  connect  
         evb   srv- address    0ms  connparams  sessparams reservation   session- reserverequest connectstream   co await httpconnectstream  connectunique  
        session  
        std  move  reservation   
        kauthority  
        std  chrono  seconds 1   
           slow foo    bar      
      
  
 
test f httpconnecttransporttest  connectshared    
  run       -  task connparams   httpcoroconnector  defaultconnectionparams    
    connparams plaintextprotocol    h2 session   co await httpcoroconnector  connect  
         evb   srv- address    0ms  connparams sessptr   session- acquirekeepalive cs1   co await connect session cs2   co await connect session port   cs1- getlocaladdress   getport    
    expect eq port  cs2- getlocaladdress   getport     
    cs1 reset    
    cs2 reset    
    cs1   co await connect session   
    expect eq port  cs1- getlocaladdress   getport     
    cs1 reset    
    co await folly  coro  co reschedule current executor  
    session- initiatedrain    
      
  
 
test f httpconnecttransporttest  connectcancelled    
  run       -  task     
    co await folly  coro  collectall  
          
              -  task     
          expect co await co withcancellation cancelsource gettoken    connect     
              operationcancelled   
             
        requestcancellation     
      
    expect co await co withcancellation  
                     cancelsource gettoken    
                     transport  newconnectedsocket  evb   srv- address    0ms    
                 operationcancelled   
      
  
 
test f httpconnecttransporttest  simplereadwrite    
  run       -  task kbufsize   65   1024 cs   co await connect    
 
      
    std  array uint8 t  kbufsize  rcvbuf  
    std  array uint8 t  kbufsize  sndbuf  
    std  memset sndbuf data sndbuf size     
 
      
    folly  coro  transportif  writeinfo info  
    co await cs- write byterange sndbuf data    sndbuf data     sndbuf size     
                       100ms  
                       folly  writeflags  none  
                        info   
    expect eq info byteswritten  sndbuf size     
    co await readall  cs  rcvbuf  0ms   
    expect eq 0  memcmp sndbuf data    rcvbuf data    rcvbuf size      
 
      
    expect eq co await cs- read folly  mutablebyterange nullptr    0   
      
  
 
test f httpconnecttransporttest  simpleiobufreadwrite    
  run       -  task kbufsize   55   1184 cs   co await connect    
 
    std  array uint8 t  kbufsize  sndbuf  
    std  memset sndbuf data sndbuf size     
 
      
    folly  coro  transportif  writeinfo info  
    co await cs- write byterange sndbuf data    sndbuf data     sndbuf size     
                       100ms  
                       folly  writeflags  none  
                        info   
    expect eq info byteswritten  sndbuf size     
 
      
    iobufqueue rcvbuf iobufqueue  cachechainlength totalbytes 0 totalbytes   kbufsize bytesread   co await cs- read rcvbuf  1000  1000  0ms   
      totalbytes    bytesread  
      
      
    connecthandler- evb- runineventbasethreadandwait connecthandler- currespsource- eom bytesread   co await cs- read rcvbuf  1000  1000  50ms   
    expect eq bytesread  0     
    bytesread   co await cs- read rcvbuf  1000  1000  50ms   
    expect eq bytesread  0 data   rcvbuf move    
    data- coalesce    
    expect eq 0  memcmp sndbuf data    data- data    data- length      
      
  
 
test f httpconnecttransporttest  readcancelled    
  run       -  task cs   co await connect reader     cs    -  task unit    
      std  array uint8 t  1024  rcvbuf  
      expect co await cs- read  
              mutablebyterange rcvbuf data     rcvbuf data     rcvbuf size      
              0ms   
          operationcancelled   
      co unit  
       
 
    co await co withcancellation  
        cancelsource gettoken    
        folly  coro  collectall requestcancellation    reader      
      
    co await co withcancellation cancelsource gettoken    reader     
      
  
 
test f httpconnecttransporttest  readtimeout    
  run       -  task cs   co await connect    
    std  array uint8 t  1024  rcvbuf  
    expect co await cs- read  
            mutablebyterange rcvbuf data     rcvbuf data     rcvbuf size      
            50ms   
        asyncsocketexception   
      
  
 
test f httpconnecttransporttest  readafterreadtimeout    
  run       -  task sess   co await httpcoroconnector  connect  
         evb   srv- address    0ms  getconnparams connectstream   
        co await httpconnectstream  connectunique sess  
                                                   sess- reserverequest    
                                                  kauthority  
                                                  std  chrono  seconds 1   
                                                     foo    bar     
                                                  egressbuffersize pconnectstream   connectstream cs   std  make unique httpconnecttransport  std  move connectstream    
 
    std  array uint8 t  1024  buf read res   co await folly  coro  co awaittry cs- read  
        mutablebyterange buf data     buf data     buf size      50ms asyncsocketex   
        check notnull read res trygetexceptionobject asyncsocketexception      
    expect eq asyncsocketex- gettype    asyncsocketexception  timed out   
 
      
    std  array 1024  sendbuf     write fin    
    co await cs- write  
        byterange sendbuf data    sendbuf data     sendbuf size      
 
      
    testing  nicemock mockhttpsessionstats  sessionstats  
    sess- setsessionstats  sessionstats   
    folly  coro  baton waituntilread call sessionstats   recordpendingbufferedreadbytes -1024   
         willbydefault         waituntilread post        
    co await waituntilread  
 
     
 
    expect pconnectstream- canread     
    read res   co await folly  coro  co awaittry cs- read  
        mutablebyterange buf data     buf data     buf size      50ms    
 
    xcheck  read res hasexception     
    expect gt read res value    0   
    sess- setsessionstats read res   co await folly  coro  co awaittry cs- read  
        mutablebyterange buf data     buf data     buf size      50ms    
    expect eq read res value    0   
      
  
 
test f httpconnecttransporttest  readerror    
  run       -  task cs   co await connect    
 
    connecthandler- evb- runineventbasethreadandwait respsource   std  exchange connecthandler- currespsource respsource- abort httperrorcode  cancel   
        
 
    std  array uint8 t  1024  rcvbuf  
    expect co await cs- read  
            mutablebyterange rcvbuf data     rcvbuf data     rcvbuf size      
            50ms   
        folly  asyncsocketexception   
      
  
 
test f httpconnecttransporttest  simplewritev    
  run       -  task cs   co await connect    
 
    iobufqueue sndbuf folly  iobufqueue  cachechainlength kbufsize   65536  
    std  array uint8 t  kbufsize  bufa  
    std  memset bufa data bufa size     
    std  array uint8 t  kbufsize  bufb  
    std  memset bufb data     b   bufb size     
    sndbuf append bufa data    bufa size     
    sndbuf append bufb data    bufb size     
 
      
    co await cs- write sndbuf   
 
    std  array uint8 t  kbufsize  rcvbufa  
    co await readall  cs  rcvbufa  500ms   
    expect eq 0  memcmp bufa data    rcvbufa data    rcvbufa size      
    std  array uint8 t  kbufsize  rcvbufb  
    co await readall  cs  rcvbufb  500ms   
    expect eq 0  memcmp bufb data    rcvbufb data    rcvbufb size      
      
  
 
test f httpconnecttransporttest  writecancelled    
  run       -  task     
      
    egressbuffersize   4096 cs   co await connect kbufsize   65536  
    std  array uint8 t  kbufsize  sndbuf  
    std  memset sndbuf data sndbuf size writer         -  task     
      expect co await co withcancellation  
                       cancelsource gettoken    
                       cs- write byterange sndbuf data    
                                           sndbuf data     sndbuf size       
                   operationcancelled   
       
 
    co await folly  coro  collectall requestcancellation    writer     
    co await co withcancellation cancelsource gettoken    writer     
      
  
 
test f httpconnecttransporttest  shutdownwrite    
  run       -  task cs   co await connect    
      
    cs- shutdownwrite    
    iobufqueue rcvbuf iobufqueue  cachechainlength bytesread   co await cs- read rcvbuf  1000  1000  500ms   
    expect eq bytesread  0     
    bytesread   co await cs- read rcvbuf  1000  1000  500ms   
    expect eq bytesread  0 kbufsize   65536  
    std  array uint8 t  kbufsize  sndbuf  
    std  memset sndbuf data sndbuf size     
    expect co await cs- write  
                     byterange sndbuf data    sndbuf data     sndbuf size      
                 folly  asyncsocketexception   
      
  
 
test f httpconnecttransporttest  closewithreadswrites    
  run       -  task cs   co await connect kbufsize   256   1024  
    std  array uint8 t  1024  rcvbuf readfut   
        co withexecutor  
             evb  
            cs- read mutablebyterange rcvbuf data    
                                       rcvbuf data     rcvbuf size      
                     0ms   
             start    
 
    std  array uint8 t  kbufsize  sndbuf  
    std  memset sndbuf data sndbuf size writefut   
        co withexecutor  
             evb  
            cs- write byterange sndbuf data    sndbuf data     sndbuf size     
                      0ms   
             start    
      
    co await folly  coro  co reschedule current executor  
 
    cs- close    
      
    co await std  move writefut   
      
      
      
    expect co await std  move readfut   folly  asyncsocketexception   
      
  
 
test f httpconnecttransporttest  closewithreset    
  connecthandler- expectexceptions    
  run       -  task cs   co await connect    
    cs- closewithreset    
      
  
 
test f httpconnecttransporttest  writesblockedpendingeof    
  run       -  task cs   co await connect kbufsize   64   3   1024   1  
    std  array uint8 t  kbufsize  sndbuf  
    std  memset sndbuf data sndbuf size writefut   
        co withexecutor  
             evb  
            cs- write byterange sndbuf data    sndbuf data     sndbuf size     
                      100ms   
             start   
             via  evb res    expect res hasexception         
    co await folly  coro  co reschedule current executor  
    cs- shutdownwrite    
    co await std  move writefut   
 
    iobufqueue rcvbuf iobufqueue  cachechainlength     
      
    std  array uint8 t  kbufsize  rcvbufb  
    co await readall  cs  rcvbufb  500ms   
    expect eq co await cs- read rcvbuf  1000  1000  500ms   0     
      
  
 
test f httpconnecttransporttest  writesblockedtimeout    
  run       -  task     
    connecthandler- timeout   std  chrono  seconds 1 cs   co await connect kbufsize   64   3   1024   1  
    std  array uint8 t  kbufsize  sndbuf  
    std  memset sndbuf data sndbuf size     
      
      
      
      
    co await cs- write byterange sndbuf data    sndbuf data     sndbuf size     
                       100ms   
      
    expect co await cs- write  
            byterange sndbuf data    sndbuf data     sndbuf size     100ms   
        asyncsocketexception   
      
  
 
