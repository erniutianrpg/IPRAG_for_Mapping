  setuprequestresponseflow  txn  reqbodysize   
 
    
  expect call transport   sendwindowupdate    reqbodysize    
 
    
  txn oningressheaderscomplete makegetrequest     
  eventbase  loop    
  
 
test f downstreamtransactiontest  nowindowupdate txn   maketxn 450     
                      http2  kinitialwindow   
  uint32 t reqbodysize   220  
  setuprequestresponseflow  txn  reqbodysize expect call transport   sendwindowupdate    reqbodysize   times 0   
 
    
  txn oningressheaderscomplete makegetrequest     
  txn oningressbody makebuf reqbodysize   0   
  txn oningresseom response   makeresponse 200   
  txn sendheaders  response txn sendbody makebuf reqbodysize    
  txn sendeom    
  eventbase  loop    
  
 
test f downstreamtransactiontest  flowcontrolinfocorrect txn   maketxn 450  100   
 
  expect call transport   getflowcontrolinfo     
       willonce invoke     httptransaction  flowcontrolinfo  info    
        info- flowcontrolenabled info- sessionsendwindow    1  
        info- sessionrecvwindow    2  
           
  httptransaction  flowcontrolinfo info  
  txn getcurrentflowcontrolinfo  info   
 
  expect eq info flowcontrolenabled expect eq info sessionsendwindow   1   
  expect eq info sessionrecvwindow   2   
  expect eq info streamrecvwindow   450   
  expect eq info streamsendwindow   100   
  
 
test f downstreamtransactiontest  expectingwindowupdate txn   maketxn 450  100   
  uint32 t reqbodysize   220  
 
    
    
  txn oningressheaderscomplete makegetrequest     
  txn pauseingress    
  txn oningressbody makebuf reqbodysize   0   
  txn oningresseom response   makeresponse 200   
  txn sendheaders  response txn sendbody makebuf reqbodysize    
  txn sendeom    
  txn onwriteready 1000  1   
  expect eq eventbase  timer   count    1   
  
 
test f downstreamtransactiontest  nowindowupdateafterdonesending txn   maketxn 450  220   
  uint32 t reqbodysize   220  
 
    
  txn oningressheaderscomplete makegetrequest     
  txn oningressbody makebuf reqbodysize   0 response   makeresponse 200   
  txn sendheaders  response txn sendbody makebuf reqbodysize    
  txn sendeom    
  txn onwriteready 1000  1   
  txn pauseingress    
  txn oningresseom    
  expect eq eventbase  timer   count    0   
  
 
 
 
