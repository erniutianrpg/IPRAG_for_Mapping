test f downstreamtransactiontest  parseerrorcbs txn   maketxn    
 
  httpexception err httpexception  direction  ingress   test    
  err sethttpstatuscode 400   
 
  insequence enforceorder  
 
  expect call handler    settransaction  txn    
  expect call handler    onerror     
       willonce invoke httpexception  ex    
        assert eq ex getdirection    httpexception  direction  ingress   
        assert eq std  string ex test    
           
    
    
  expect call transport   sendabort         
 
    
    
    
  expect call handler    onerror     
       willonce invoke httpexception  ex    
        expect eq ex getdirection    
                  httpexception  direction  ingress egress   
        expect ne  
            std  string ex find  oningressbody ingress closed    
            std  string  npos   
           
  expect call handler    detachtransaction     
  expect call transport   detach  txn    
 
  txn sethandler  handler    
  txn onerror err   
    
    
    
  txn oningressbody makebuf 10   0   
 
  eventbase  loop    
  
 
test f downstreamtransactiontest  detachfromnotify    
  unique ptr strictmock mockhttphandler   handler strictmock mockhttphandler txn   maketxn    
 
  insequence enforceorder  
 
  expect call  handler   settransaction  txn    
  expect call  handler   onheaderscomplete     
       willonce invoke     std  shared ptr httpmessage response   makeresponse 200   
        txn sendheaders  response txn sendbody makebuf 10    
           
  expect call transport   sendheaders  txn            
       willonce invoke     unused httpmessage  headers  unused  unused    
        expect eq headers getstatuscode    200   
           
  expect call transport   notifyegressbodybuffered 10    
  expect call transport   notifyegressbodybuffered -10   
       willonce invokewithoutargs         
        txn sethandler handler reset    
           
  expect call transport   detach  txn    
 
  httpexception err httpexception  direction  ingress egress   test    
 
  txn sethandler handler txn oningressheaderscomplete makegetrequest     
  txn onerror err   
  
 
test f downstreamtransactiontest  deferredegress    
  expect call transport   describe     willrepeatedly expect call transport   notifypendingegress    willrepeatedly txn   maketxn 10  10   
 
  insequence enforceorder  
 
  expect call handler    settransaction  txn    
  expect call handler    onheaderscomplete     
       willonce invoke     std  shared ptr httpmessage response   makeresponse 200   
        txn sendheaders  response txn sendbody makebuf 10    
        txn sendbody makebuf 20    
        txn sendbody makebuf 30    
           
  expect call transport   sendheaders  txn            
       willonce invoke     unused httpmessage  headers  unused  unused    
        expect eq headers getstatuscode    200   
           
 
    
  expect call transport   notifyegressbodybuffered 10    
  expect call handler    onegresspaused     
  expect call transport   notifyegressbodybuffered 20    
  expect call transport   notifyegressbodybuffered 30    
 
  txn sethandler  handler    
  txn oningressheaderscomplete makegetrequest     
 
    
  expect call transport   notifyegressbodybuffered -30    
 
  txn oningresswindowupdate 20   
  expect eq txn onwriteready 30  1 expect call transport   notifyegressbodybuffered -30    
  expect call handler    onerror      
  expect call handler    detachtransaction     
  expect call transport   detach  txn    
 
  httpexception err httpexception  direction  ingress egress   test    
  txn onerror err   
  
 
