 proxygen  parsehttpdatetime  
 
test httptimetests  invalidtimetest    
  expect parsehttpdatetime  hello  world value     
  expect parsehttpdatetime  sun  33 nov 1994 08 49 37 gmt value     
  expect parsehttpdatetime  sun  06 nov 1800 value     
  
 
test httptimetests  validtimetest    
    
  expect parsehttpdatetime  sun  06 nov 1994 08 49 37 gmt value     
  expect parsehttpdatetime  sunday  06-nov-94 08 49 37 gmt value     
  expect parsehttpdatetime  sun nov  6 08 49 37 1994 value     
  
 
test httptimetests  equaltimetest parsehttpdatetime  thu  07 mar 2013 08 49 37 gmt    
  expect value b   parsehttpdatetime  thursday  07-mar-13 08 49 37 gmt    
  expect b value c   parsehttpdatetime  thu mar 7 08 49 37 2013    
  expect c value     
 
  expect eq value    b value     
  expect eq value    c value     
  expect eq b value    c value     
  
 
test httptimetests  reallyoldtimetest parsehttpdatetime  thu  07 mar 1970 08 49 37 gmt    
  expect value b   parsehttpdatetime  thu  07 mar 1971 08 49 37 gmt    
  expect b value c   parsehttpdatetime  thu  07 mar 1980 08 49 37 gmt    
  expect c value     
 
  expect lt b   
  expect lt c   
  expect lt b  c   
  
 
test httptimetests  tztounixtstest parsehttpdatetime  wed  13 jun 2018 21 43 49 gmt    
  expect eq value    1528926229 b   parsehttpdatetime  wed  31 dec 1969 23 59 59 gmt    
  expect eq b value    -1 c   parsehttpdatetime  thu  01 jan 1970 00 00 00 gmt    
  expect eq c value    0 d   parsehttpdatetime  thu  01 jan 1970 00 00 01 gmt    
  expect eq d value    1 e   parsehttpdatetime  wed  13-jun-18 21 43 49 gmt    
  expect eq e value    1528926229 f   parsehttpdatetime  wed  31-dec-69 23 59 59 gmt    
  expect eq f value    -1 g   parsehttpdatetime  wed  01-jan-70 00 00 00 gmt    
  expect eq g value    0 h   parsehttpdatetime  thu  01-jan-70 00 00 01 gmt    
  expect eq h value    1 parsehttpdatetime  wed jun 13 21 43 49 2018    
  expect eq value    1528926229 j   parsehttpdatetime  wed dec 31 23 59 59 1969    
  expect eq j value    -1 k   parsehttpdatetime  thu jan 1 00 00 00 1970    
  expect eq k value    0 l   parsehttpdatetime  thu jan 1 00 00 01 1970    
  expect eq l value    1 m   parsehttpdatetime  tue  19 jan 2038 03 14 07 gmt    
  expect eq m value    2147483647 n   parsehttpdatetime  thu  01 jan 1970 00 00 01 pst    
  expect n value o   parsehttpdatetime  thu  01 jan 1970 00 00 01    
  expect o value     
   proxygen lib utils test httptimetest