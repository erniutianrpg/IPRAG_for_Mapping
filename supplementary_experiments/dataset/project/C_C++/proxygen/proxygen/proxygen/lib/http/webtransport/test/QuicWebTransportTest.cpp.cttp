test f quicwebtransporttest  closetransportcancelsreadtokens    
  webtransport  streamreadhandle  readhandle1 webtransport  streamreadhandle  readhandle2 folly  cancellationtoken token1  
  folly  cancellationtoken token2  
 
    
  expect call  handler   onnewunistream     
       willonce     webtransport  streamreadhandle  handle    
        readhandle1   handle  
        token1   handle- getcanceltoken    
         
       willonce     webtransport  streamreadhandle  handle    
        readhandle2   handle  
        token2   handle- getcanceltoken    
          
 
    
  socketdriver  addreadevent 2 socketdriver  addreadevent 6 eventbase  looponce    
 
  assert ne readhandle1 assert ne readhandle2 expect token1 iscancellationrequested     
  expect token2 iscancellationrequested future1   readhandle1- readstreamdata readerrorreceived std  move future1  
       via  eventbase   
       thentry     folly webtransport  streamdata  result    
        expect result hasexception ex   result trygetexceptionobject webtransport  exception     
        assert ne ex expect eq ex wt 1   
        readerrorreceived expect call  handler   onsessionend      
  socketdriver  deliverconnectionerror quic  quicerror  
      quic  applicationerrorcode wt 1    connection close     
  eventbase  loop    
 
    
  expect token1 iscancellationrequested     
  expect token2 iscancellationrequested     
 
    
  expect readerrorreceived   
  
 
test f quicwebtransporttest  destructorterminatesopenstreams    
  webtransport  streamreadhandle  unireadhandle webtransport  streamreadhandle  bidireadhandle webtransport  streamwritehandle  bidiwritehandle webtransport  streamwritehandle  uniwritehandle expect call  handler   onnewunistream     
       willonce     webtransport  streamreadhandle  handle    
        unireadhandle   handle  
          
  socketdriver  addreadevent 2 eventbase  looponce    
  assert ne unireadhandle expect call  handler   onnewbidistream     
       willonce     webtransport  bidistreamhandle handle    
        bidireadhandle   handle readhandle  
        bidiwritehandle   handle writehandle  
          
  socketdriver  addreadevent 0 eventbase  looponce    
  assert ne bidireadhandle assert ne bidiwritehandle unistreamres   webtransport  - createunistream    
  assert unistreamres hasvalue     
  uniwritehandle   unistreamres value unireaderrorreceived bidireaderrorreceived unireadfuture   unireadhandle- readstreamdata    
  std  move unireadfuture  
       via  eventbase   
       thentry     folly webtransport  streamdata  result    
        expect result hasexception ex   result trygetexceptionobject webtransport  exception     
        assert ne ex expect eq ex 0   
        unireaderrorreceived bidireadfuture   bidireadhandle- readstreamdata    
  std  move bidireadfuture  
       via  eventbase   
       thentry     folly webtransport  streamdata  result    
        expect result hasexception ex   result trygetexceptionobject webtransport  exception     
        assert ne ex expect eq ex 0   
        bidireaderrorreceived unireadtoken   unireadhandle- getcanceltoken bidireadtoken   bidireadhandle- getcanceltoken bidiwritetoken   bidiwritehandle- getcanceltoken uniwritetoken   uniwritehandle- getcanceltoken    
 
    
  expect unireadtoken iscancellationrequested     
  expect bidireadtoken iscancellationrequested     
  expect bidiwritetoken iscancellationrequested     
  expect uniwritetoken iscancellationrequested     
 
    
    
    
    
  transport  reset    
  eventbase  loop    
 
    
  expect unireadtoken iscancellationrequested     
  expect bidireadtoken iscancellationrequested     
  expect bidiwritetoken iscancellationrequested     
  expect uniwritetoken iscancellationrequested     
 
    
  expect unireaderrorreceived   
  expect bidireaderrorreceived   
  
 
  
  
  
  
  
  
  
  
  
  
  
  
  
