test f quicwebtransporttest  peerunistream    
  expect call  handler   onnewunistream     
       willonce webtransport  streamreadhandle  readhandle    
        readhandle- awaitnextread  
             eventbase   
               webtransport  streamreadhandle   
               uint64 t  
               folly webtransport  streamdata  data    
              expect data hasexception     
              expect eq data- data- computechaindatalength    5   
              expect data- fin   
                
          
  socketdriver  addreadevent 2  folly  iobuf  copybuffer  hello eventbase  loop    
  
 
test f quicwebtransporttest  peerbidistream    
  expect call  handler   onnewbidistream     
       willonce webtransport  bidistreamhandle bidihandle wtimpl   dynamic cast webtransportimpl   transport assert ne wtimpl wtimpl- onmaxdata 1000   
        bidihandle writehandle- writestreamdata  
            folly  iobuf  copybuffer  hello bidihandle readhandle- awaitnextread  
             eventbase   
               webtransport  streamreadhandle   
               uint64 t  
               folly webtransport  streamdata  data    
              expect data hasexception     
              expect data- fin   
                
          
  socketdriver  addreadevent 0 eventbase  loop    
  expect eq socketdriver  streams  0  writebuf chainlength    5   
  
 
test f quicwebtransporttest  newunistream handle   webtransport  - createunistream    
  expect handle hasvalue id   handle value  - getid    
  handle value  - resetstream wt 1   
  eventbase  loop    
  expect eq socketdriver  streams  id wt 1   
  
 
test f quicwebtransporttest  newbidistream handle   webtransport  - createbidistream    
  expect handle hasvalue id   handle- readhandle- getid    
  handle- readhandle- stopsending wt 1   
  expect eq socketdriver  streams  id wt 1   
  handle- writehandle- resetstream wt 2   
  expect eq socketdriver  streams  id wt 2   
  
 
test f quicwebtransporttest  datagram    
  webtransport  - senddatagram folly  iobuf  copybuffer  hello     
  expect eq socketdriver  outdatagrams  front   chainlength    5   
  socketdriver  adddatagram folly  iobuf  copybuffer  world      
