test f qmuxsessiontest  writewithbyteeventcallback firesonbyteevent created   session - createbidistream    
  assert created hasvalue streamid   created value   writehandle- getid    
 
  recordingbyteeventcallback byteeventcb std  string payload    byte-event-payload writeresult   created value   writehandle- writestreamdata  
      folly  iobuf  copybuffer payload byteeventcb   
  assert writeresult hasvalue     
  drain    
 
    
  parsewrites    
  expect wire  cb connectionerrors empty     
 
    
    
    
  assert eq byteeventcb byteevents size    1   
  expect eq byteeventcb byteevents 0  first  streamid   
  expect eq byteeventcb byteevents 0  second  payload size   - 1   
  expect byteeventcb canceledevents empty     
  
 
  
  
  
  
test f qmuxsessiontest  closesession cancelsqueuedbyteevent created   session - createbidistream    
  assert created hasvalue streamid   created value   writehandle- getid    
 
  recordingbyteeventcallback byteeventcb std  string payload  1    16    5000   x writeresult   created value   writehandle- writestreamdata  
      folly  iobuf  copybuffer payload byteeventcb   
  assert writeresult hasvalue     
  drain    
 
    
  expect byteeventcb byteevents empty     
  expect byteeventcb canceledevents empty res   session - closesession  folly  optional uint32 t  42    
  assert res hasvalue     
  transport - addreadevent drain    
 
  expect byteeventcb byteevents empty     
  assert eq byteeventcb canceledevents size    1   
  expect eq byteeventcb canceledevents 0  first  streamid   
  expect eq byteeventcb canceledevents 0  second  payload size   - 1   
  
 
