test f hqstreambasetest  testsinglestreambidir    
  expect eq kdefaultbidirstream  ssbidirmapping - getegressstreamid     
  expect eq kdefaultbidirstream  ssbidirmapping - getingressstreamid     
  expect eq kdefaultbidirstream  ssbidirmapping - getstreamid     
 
  expect ssbidirmapping - isusing kdefaultbidirstream    
 
  expect ssbidirmapping - isusing kdefaultegressstream    
  expect ssbidirmapping - isusing kdefaultingressstream    
  
 
test f hqstreambasetest  testsinglestreamegressonly    
  expect eq kdefaultegressstream  ssegressmapping - getegressstreamid     
  expect eq kdefaultegressstream  ssegressmapping - getstreamid     
 
  expect ssegressmapping - isusing kdefaultegressstream    
 
  expect ssegressmapping - isusing kdefaultbidirstream    
  expect ssegressmapping - isusing kdefaultingressstream    
  
 
test f hqstreamdeathtest  testsinglestreamegressonly    
  expect exit ssegressmapping - getingressstreamid    
              killedbysignal sigabrt   
               egress only stream    
  
 
test f hqstreambasetest  testcompositebidirempty    
  expect csbidirmappingempty - isusing kdefaultegressstream    
  expect csbidirmappingempty - isusing kdefaultingressstream    
  expect csbidirmappingempty - isusing kdefaultbidirstream    
  
 
test f hqstreamdeathtest  testcompositebidirempty    
  expect exit csbidirmappingempty - getingressstreamid    
              killedbysignal sigabrt   
               ingress stream must assigned before being accessed    
  expect exit csbidirmappingempty - getegressstreamid    
              killedbysignal sigabrt   
               egress stream must assigned before being accessed    
  expect exit csbidirmappingempty - getstreamid    
              killedbysignal sigabrt   
               ambiguous call  getstreamid composite stream    
  
 
