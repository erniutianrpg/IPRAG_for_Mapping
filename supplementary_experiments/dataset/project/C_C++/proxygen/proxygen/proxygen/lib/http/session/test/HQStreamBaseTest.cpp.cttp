            csbidirmappingegressset - getegressstreamid     
 
  expect csbidirmappingegressset - isusing kdefaultegressstream    
 
  expect csbidirmappingegressset - isusing kdefaultingressstream    
  expect csbidirmappingegressset - isusing kdefaultbidirstream    
  
 
