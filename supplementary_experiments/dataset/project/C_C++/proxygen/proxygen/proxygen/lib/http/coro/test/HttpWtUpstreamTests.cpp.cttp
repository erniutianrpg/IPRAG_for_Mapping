  expect call ingresssource  readbodyevent     
       willonce folly  coro  maketask httpbodyevent   
          httpbodyevent folly  iobufqueue ingress folly  iobufqueue  cachechainlength readres   co await co awaittry  
      transport- read ingress  
                       0  
                       0  
                       std  chrono  milliseconds 0     
  expect readres hasvalue       readres    0   
 
    
  readres   co await co awaittry  
      transport- read ingress  
                       0  
                       0  
                       std  chrono  milliseconds 0 ex   readres trygetexceptionobject folly  asyncsocketexception     
  expect ex    
              ex- gettype      folly  asyncsocketexception  internal co test f httpstreamtransport  simpleread    
    
  expect call ingresssource  readbodyevent     
       willonce folly  coro  maketask httpbodyevent   
          httpbodyevent makebuf 100 folly  iobufqueue ingress folly  iobufqueue  cachechainlength readres   
      co await transport- read ingress  
                                0  
                                0  
                                std  chrono  milliseconds 0    
  expect eq readres  100   
  
 
