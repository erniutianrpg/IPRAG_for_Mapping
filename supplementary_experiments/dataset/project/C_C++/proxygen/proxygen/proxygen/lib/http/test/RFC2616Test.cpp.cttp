 proxygen rfc2616  parsebyterangespec std  string  
 
test qvaluetest  basic    
 
  rfc2616  tokenpairvec output  
 
    
    string test  iso-8859-5  unicode-1-1 q 0 8    
    expect rfc2616  parseqvalues test  output    
    expect eq output size    2   
    expect eq output 0  first compare folly  stringpiece  iso-8859-5     0   
    expect eq output 0  second  1   
    expect eq output 1  first compare folly  stringpiece  unicode-1-1     0   
    expect eq output 1  second  0 8   
    output clear    
    
 
    
    string test  compress  gzip    
    expect rfc2616  parseqvalues test  output    
    expect eq output size    2   
    expect eq output 0  first compare folly  stringpiece  compress     0   
    expect eq output 0  second  1   
    expect eq output 1  first compare folly  stringpiece  gzip     0   
    expect eq output 1  second  1   
    output clear    
    
 
    
    string test  
      
    expect rfc2616  parseqvalues test  output    
    expect eq output size    0   
    
 
    
    string test       
      
    expect rfc2616  parseqvalues test  output    
    expect eq output size    0   
    
 
    
    string test  compress q 0 5  gzip q 1 0    
    expect rfc2616  parseqvalues test  output    
    expect eq output size    2   
    expect eq output 0  first compare folly  stringpiece  compress     0   
    expect eq output 0  second  0 5   
    expect eq output 1  first compare folly  stringpiece  gzip     0   
    expect eq output 1  second  1 0   
    output clear    
    
 
    
    string test  gzip q 1 0  identity  q 0 5    q 0    
    expect rfc2616  parseqvalues test  output    
    expect eq output size    3   
    expect eq output 0  first compare folly  stringpiece  gzip     0   
    expect eq output 0  second  1   
    expect eq output 1  first compare folly  stringpiece  identity     0   
    expect eq output 1  second  0 5   
    expect eq output 2  first compare folly  stringpiece        0   
    expect eq output 2  second  0   
    output clear    
    
 
    
    string test  da  en-gb q 0 8  en q 0 7    
    expect rfc2616  parseqvalues test  output    
    expect eq output size    3   
    expect eq output 0  first compare folly  stringpiece  da     0   
    expect eq output 0  second  1   
    expect eq output 1  first compare folly  stringpiece  en-gb     0   
    expect eq output 1  second  0 8   
    expect eq output 2  first compare folly  stringpiece  en     0   
    expect eq output 2  second  0 7   
    output clear    
    
  
 
test qvaluetest  extras    
 
  rfc2616  tokenpairvec output  
 
  string test  gzip    
  expect rfc2616  parseqvalues test  output    
  expect eq output size    1   
  expect eq output 0  first compare folly  stringpiece  gzip     0   
  expect eq output 0  second  1   
  output clear    
  
 
test qvaluetest  invalids    
 
  rfc2616  tokenpairvec output  
 
  string test1         
  expect rfc2616  parseqvalues test1  output    
  expect eq output size    0   
  output clear    
 
  string test2      q 0 1    
  expect rfc2616  parseqvalues test2  output    
  expect eq output size    0   
  output clear    
 
  string test3  gzip  q uietplease    
  expect rfc2616  parseqvalues test3  output    
  expect eq output size    1   
  expect eq output 0  first compare folly  stringpiece  gzip     0   
  expect eq output 0  second  1   
  output clear    
  
 
test parseencodingtest  simple    
  string test  zstd q 1 0 wl 20 gzip q 0 0 encodings   rfc2616  parseencoding test   
  expect encodings hasexception     
  expect eq encodings value    
             rfc2616  encodinglist   zstd      q    1 0      wl    20      
                                     gzip      q    0 0         
  
 
test parseencodingtest  whitespace    
  string test  zstd   q   t1 0   wl   20   gzip   t q   0 0 encodings   rfc2616  parseencoding test   
  expect encodings hasexception     
  expect eq encodings value    
             rfc2616  encodinglist   zstd      q    1 0      wl    20      
                                     gzip      q    0 0         
  
 
test parseencodingtest  invalid    
  expect rfc2616  parseencoding     hasexception     
  expect rfc2616  parseencoding      hasexception     
  expect rfc2616  parseencoding      hasexception     
  expect rfc2616  parseencoding       hasexception     
  expect rfc2616  parseencoding       hasexception     
  expect rfc2616  parseencoding        hasexception     
  expect rfc2616  parseencoding          hasexception     
  expect rfc2616  parseencoding      hasexception     
  expect rfc2616  parseencoding       hasexception     
  expect rfc2616  parseencoding       hasexception     
  expect rfc2616  parseencoding        hasexception     
  expect rfc2616  parseencoding          hasexception     
  expect rfc2616  parseencoding               hasexception     
 
  expect rfc2616  parseencoding  zstd   gzip   hasexception     
  expect rfc2616  parseencoding  zstd  wat gzip   hasexception     
  
 
test acceptencodingtest  simple    
  expect rfc2616  acceptsencoding  zstd    zstd     
  expect rfc2616  acceptsencoding  zstd  gzip    zstd     
  expect rfc2616  acceptsencoding  gzip    zstd     
  expect rfc2616  acceptsencoding       zstd     
  
 
test acceptencodingtest  qvalues    
  expect rfc2616  acceptsencoding  zstd    zstd     
  expect rfc2616  acceptsencoding  zstd q 1 0    zstd     
  expect rfc2616  acceptsencoding  zstd q wat    zstd     
  expect rfc2616  acceptsencoding  zstd q 0 0    zstd     
  
 
test acceptencodingtest  whitespace    
  expect rfc2616  acceptsencoding   zstd     zstd     
  expect rfc2616  acceptsencoding   zstd      zstd     
  expect rfc2616  acceptsencoding  gzip  br  t   tzstd     zstd     
  expect rfc2616  acceptsencoding  gzip   tdeflate  br  t     zstd     
  expect rfc2616  acceptsencoding  zstd q 0 0    zstd     
  expect rfc2616  acceptsencoding  zstd  q   0 0     zstd     
  
 
test byterangespectest  valids firstbyte   ulong max lastbyte   ulong max instancelength   ulong max  
 
  assert parsebyterangespec  
       bytes 0-10 100   firstbyte  lastbyte  instancelength    
  expect eq 0  firstbyte   
  expect eq 10  lastbyte   
  expect eq 100  instancelength   
 
  assert parsebyterangespec  bytes   100   firstbyte  lastbyte  instancelength    
  expect eq 0  firstbyte   
  expect eq ulong max  lastbyte   
  expect eq 100  instancelength   
 
  assert parsebyterangespec  bytes 0-10 
100   dummy  dummy  dummy   
          spec cannot contain wildcard initial range   
 
  folly  stringpiece sp  bytes 0-10 100    
  sp subtract 3   
  expect parsebyterangespec sp  dummy  dummy  dummy   
          spec stringpiece ends before instance length   
  sp subtract 1   
  expect parsebyterangespec sp  dummy  dummy  dummy   
          spec stringpiece ends before     character   
  sp subtract 2   
  expect parsebyterangespec sp  dummy  dummy  dummy   
          spec stringpiece ends before last byte initial byte range   
  sp subtract 1   
  expect parsebyterangespec sp  dummy  dummy  dummy   
          spec stringpiece ends before initial byte range   
  sp subtract 2   
  expect parsebyterangespec sp  dummy  dummy  dummy   
          spec stringpiece ends before first byte initial byte range   
