test f sessionpoolfixture  drainonshutdown session   makeparallelsession    
 
  sessionpool p 10  std  chrono  milliseconds 4    
  p putsession session   
  assert eq p getnumsessions    1   
  assert eq p getnumidlesessions    1   
  assert eq p getnumactivesessions    0 txn   p gettransaction assert txn assert eq p getnumsessions    1   
  assert eq p getnumidlesessions    0   
  assert eq p getnumactivesessions    1   
  assert eq p getnumactivenonfullsessions    1   
  assert eq session- getnumoutgoingstreams    1   
 
    
  session- gettransport  - closenow    
  assert eq session- getconnectionclosereason    
            connectionclosereason  kmax reason   
 
    
  assert p gettransaction assert eq session- getconnectionclosereason    
            connectionclosereason  shutdown   
  assert eq p getnumsessions    0   
  assert eq session- getnumoutgoingstreams    1   
 
    
  txn- sendabort testidlecontroller serveridlesessioncontroller sessionpool  popbestidlepool serveridlesessioncontroller  popbestidlepool    
    
   
 
test f sessionpoolfixture  moveidlesessionbetweenthreadstest    
  testidlecontroller ctrl  
  httpupstreamsession  session folly  baton   t1initbaton  t2initbaton  transferbaton  
    
  std  thread t1       
    folly  eventbasemanager seteventbase  evb sessionpool p1 10  
                   std  chrono  seconds 30   
                   std  chrono  milliseconds 0 ctrl   
      
    session   makeparallelsession    
    p1 putsession session   
    t1initbaton post    
    evb  loopforever    
      
 
    
    
  t1initbaton wait    
 
  folly  eventbase evb2  
  std  thread t2       
    folly  eventbasemanager seteventbase  evb2 sessionpool p2 10  
                   std  chrono  seconds 30   
                   std  chrono  milliseconds 0 ctrl   
    t2initbaton post    
    evb2 loopforever    
      
 
  t2initbaton wait    
    
  evb2 runineventbasethread       
    ctrl getidlesession   via  evb2  thenvalue  
            httpsessionbase  idlesession    
          assert eq idlesession  session   
            
          transferbaton post    
            
      
  transferbaton wait    
  expect eq ctrl popbestidlepool session- drain    
  evb  terminateloopsoon    
  evb2 terminateloopsoon    
  t1 join    
  t2 join    
  
 
