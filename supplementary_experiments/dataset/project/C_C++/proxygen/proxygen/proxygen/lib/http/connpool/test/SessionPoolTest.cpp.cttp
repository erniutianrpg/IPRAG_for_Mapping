test f sessionpoolfixture  serialpoolpurge sessionlimit   10 sessionput   12  
  httptransaction  txns sessionput   
 
  sessionpool p sessionlimit 0 sessionput p putsession makeserialsession     
    
 
  evb  loop    
  assert eq activated   0   
  assert eq deactivated   0   
  assert eq closed   sessionput - sessionlimit 0 sessionput txns p gettransaction sessionlimit    
      assert txns assert txns assert eq activated   sessionlimit   
 
    
  p setmaxidlesessions 0   
    
  assert eq deactivated   0 0 sessionput txns txns sendabort    
      
    
  evb  loop    
  assert eq activated   sessionlimit   
  assert eq deactivated   sessionlimit   
  assert eq closed   sessionput   
  
 
test f sessionpoolfixture  parallelpoollists    
    
    
  sessionpool p 2   
  std  vector httptransaction   txnssess1  
  std  vector httptransaction   txnssess2 sess1   makeparallelsession sess2   makeparallelsession    
  p putsession sess1   
  p putsession sess2   
  txnssess1 push back check notnull p gettransaction sess2- getnumoutgoingstreams     sess1- getnumoutgoingstreams      
    std  swap sess1  sess2   
    
  assert eq sess1- getnumoutgoingstreams    1   
  assert eq sess2- getnumoutgoingstreams    0   
  assert eq activated   1   
  assert eq deactivated   0   
  assert eq closed   0 sess1- supportsmoretransactions      
    txnssess1 push back check notnull p gettransaction assert eq sess1- getnumoutgoingstreams    
            sess1- getmaxconcurrentoutgoingstreams     
  assert eq sess2- getnumoutgoingstreams    0   
  assert eq activated   1   
  assert eq deactivated   0   
  assert eq closed   0 sess2- supportsmoretransactions      
    txnssess2 push back check notnull p gettransaction assert eq sess1- getnumoutgoingstreams    
            sess1- getmaxconcurrentoutgoingstreams     
  assert eq sess2- getnumoutgoingstreams    
            sess2- getmaxconcurrentoutgoingstreams     
  assert eq activated   2   
  assert eq deactivated   0   
  assert eq closed   0   
 
    
  check p gettransaction evb  loop    
  assert eq sess1- getnumoutgoingstreams    
            sess1- getmaxconcurrentoutgoingstreams     
  assert eq sess2- getnumoutgoingstreams    
            sess2- getmaxconcurrentoutgoingstreams     
  assert eq activated   2   
  assert eq deactivated   0   
  assert eq closed   0 txn   txnssess1    
    txn- sendabort    
    
  assert eq activated   2   
  assert eq deactivated   1   
  assert eq closed   0   
 
    
    
  evb  loop    
  assert eq closed   0   
 
    
    
  p setmaxidlesessions 0   
  evb  loop    
  assert eq closed   1   
 
    
    
  txnssess2 back  - sendabort    
  txnssess2 pop back    
  assert eq deactivated   1   
  txnssess2 push back check notnull p gettransaction txn   txnssess2    
    assert eq closed   1   
    txn- sendabort    
    
  assert eq activated   2   
  assert eq deactivated   2   
  assert eq closed   2   
  evb  loop    
  
 
test f sessionpoolfixture  outstandingwrites codec   makeserialcodec    
  expect call  codec  generateheader                    
       willonce invoke    folly  iobufqueue  writebuf  
                          httpcodec  streamid httpmessage httpheadersize  size  
                          folly  optional httpheaders     
        writebuf append  somedata size    
          size- uncompressed   8 sess   makesession std  move codec    
 
  sessionpool p 1   
  p putsession sess   
  assert attached    
  assert sess- isclosing txn   check notnull p gettransaction assert attached    
  txn- sendheaders httpmessage     
  txn- sendabort    
    
    
  assert sess- isclosing     
 
  evb  loop    
    
  assert attached    
  assert eq deactivated   1   
  assert eq closed   1   
  
 
test f sessionpoolfixture  outstandingtransaction sess   makeserialsession    
  httptransaction  txn sessionpool p 1   
    p putsession sess   
    assert attached    
    txn   p gettransaction check notnull txn   
    assert attached    
    assert eq deactivated   0   
    assert eq closed   0   
    assert eq p getnumsessions    1   
    
    
    
    
  assert eq deactivated   1   
  assert eq closed   1   
 
    
  assert attached    
  txn- sendabort    
  assert attached    
  
 
test f sessionpoolfixture  droppedrequestnotpooled    
    
  sessionpool p 10  std  chrono  seconds 4 codec   makeserialcodec shouldbebusy expect call  codec  isbusy    willrepeatedly invoke shouldbebusy sess   makesession std  move codec    
  p putsession sess txn1   p gettransaction assert eq p getnumidlesessions    0   
  assert eq p getnumactivesessions    1   
  assert eq p getnumsessions    1   
 
  httpmessage req  
  req setmethod req seturl string        
  req sethttpversion 1  1   
  txn1- sendheaders req   
  txn1- sendeom    
  shouldbebusy assert attached    
  evb  loop    
    
    
  check  timeout    
  assert attached    
 
    
  assert eq p getnumidlesessions    0   
  assert eq p getnumactivesessions    1   
  assert eq p getnumsessions    1   
  txn1- sendabort    
    
    
 
    
  assert eq p getnumidlesessions    0   
  assert eq p getnumactivesessions    0   
  assert eq p getnumsessions    0   
  assert p gettransaction evb  loop    
  
 
