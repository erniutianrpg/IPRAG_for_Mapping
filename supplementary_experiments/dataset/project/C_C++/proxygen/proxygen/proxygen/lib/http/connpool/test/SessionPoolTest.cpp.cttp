test f sessionpoolfixture  serveridlesessioncontrollertest    
  testidlecontroller ctrl  
  sessionpool p1  p2 s1   makeparallelsession    s2   makeparallelsession    
       s3   makeparallelsession    
  expect eq ctrl popbestidlepool ctrl addidlesession s1   p1   
  expect eq ctrl popbestidlepool     p1   
  expect eq ctrl popbestidlepool ctrl addidlesession s3   p2   
  ctrl addidlesession s1   p1   
  expect eq ctrl popbestidlepool     p2   
  expect eq ctrl popbestidlepool     p1   
  expect eq ctrl popbestidlepool ctrl addidlesession s1   p1   
  ctrl addidlesession s2   p1   
  ctrl removeidlesession s1   
  ctrl addidlesession s3   p2   
  expect eq ctrl popbestidlepool     p1   
  expect eq ctrl popbestidlepool     p2   
  expect eq ctrl popbestidlepool s1- drain    
  s2- drain    
  s3- drain    
  
 
test f sessionpoolfixture  writepausedsessionnotmarkedasidle codec   makeparallelcodec    
  expect call  codec  generateheader                    
       willonce invoke    folly  iobufqueue  writebuf  
                          httpcodec  streamid httpmessage httpheadersize  size  
                          folly  optional httpheaders     
        writebuf append  somedata size    
          size- uncompressed   8 session   makesession std  move codec    
 
  testidlecontroller ctrl  
  sessionpool p1 10  
                 std  chrono  seconds 30   
                 std  chrono  milliseconds 0 ctrl   
  p1 putsession session txn   p1 gettransaction assert ne txn   httptransaction transport   
      session- gettransport  - getunderlyingtransport testasynctransport     
  transport- pausewrites    
  httpmessage req  
  req setmethod req seturl string        
  req sethttpversion 1  1   
  txn- sendheaders req   
  evb  looponce    
  txn- sendabort    
 
  transport- resumewrites    
  evb  looponce    
 
    
  expect eq ctrl popbestidlepool expect eq p1 getnumsessions    1   
  expect eq p1 getnumidlesessions    0   
  expect eq p1 getnumactivesessions    1   
  expect eq p1 getnumactivenonfullsessions    1   
  
 
test f sessionpoolfixture  threadidlesessioncontrollerlimitstotalidle    
  threadidlesessioncontroller controller 3   
  sessionpool p1 2  
                 std  chrono  milliseconds 50   
                 std  chrono  milliseconds 50   
                  controller   
  sessionpool p2 2  
                 std  chrono  milliseconds 50   
                 std  chrono  milliseconds 50   
                  controller   
 
    
  p1 putsession makeserialsession     
  p1 putsession makeserialsession     
 
  p2 putsession makeserialsession     
  p2 putsession makeserialsession     
 
    
  expect eq controller gettotalidlesessions    3 txn   p1 gettransaction assert txn txn- sendabort    
 
  evb  loop    
  assert eq closed   2   
  expect eq controller gettotalidlesessions    2   
  expect eq p1 getnumidlesessions    0   
  expect eq p2 getnumidlesessions    2   
  
 
