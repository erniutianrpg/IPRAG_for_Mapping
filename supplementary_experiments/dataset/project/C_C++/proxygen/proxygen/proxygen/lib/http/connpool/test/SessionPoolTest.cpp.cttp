test f sessionpoolfixture  drainsessionlater    
    
  sessionpool p 10  std  chrono  seconds 4 session   makeparallelsession    
  p putsession session txn1   check notnull p gettransaction txn2   check notnull p gettransaction session- drain    
  assert eq p getnumsessions    1     
  check p gettransaction assert eq p getnumsessions    0   
    
  txn1- sendabort    
  txn2- sendabort    
  
 
test f sessionpoolfixture  insertdrainedsession session   makeparallelsession    
  check notnull session- newtransaction session- drain cm   wangle  connectionmanager  makeunique  
       evb   std  chrono  milliseconds 1 sessionpool p 10  std  chrono  seconds 4   std  chrono  seconds 0    
  cm- addconnection session   
  p putsession session   
  assert eq p getnumsessions    0   
  check p gettransaction cm- dropallconnections    
  expect eq numsessions   0   
  
 
test f sessionpoolfixture  closenotreusable    
    
    
  sessionpool p 10  std  chrono  seconds 4 reusable codec   std  make unique nicemock mockhttpcodec      
  expect call  codec  gettransportdirection    
       willrepeatedly transportdirection  upstream    
  expect call  codec  createstream    willonce 1    
  expect call  codec  isreusable    willrepeatedly returnpointee  reusable    
  expect call  codec  supportsparallelrequests    willrepeatedly expect call  codec  getprotocol    
       willrepeatedly codecprotocol  http 2    
 
  p putsession makesession std  move codec     
  assert eq p getnumsessions    1 txn   check notnull p gettransaction reusable txn- sendabort    
  assert eq p getnumsessions    0     
  
 
