  size t cachingmaxsize   4096  
  size t cachingclearsize   1  
  size t stalecachesizemultiplier   4  
  size t stalecachettlmin   24   60   60  
  size t stalecachettlscale   3 cachingdnsresolverfixture testing  test setup   override   
    initializewithdefaultparams initializeresolverwithparams cachingdnsparams  params    
