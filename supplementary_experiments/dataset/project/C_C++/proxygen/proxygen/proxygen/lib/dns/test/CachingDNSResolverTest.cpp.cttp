test f cachingdnsresolverfixture  nocrashwhiledestructing    
  string hostname  foo bar com    
  cachingresolver - resolvehostname  cb   hostname   
  cachingresolver  reset      
  
 
test f cachingdnsresolverfixture  resolutionerror    
  underlyingresolver - setisrunning cachingresolver - resolvehostname  cb fail    
  expect eq cb  getnumfailures    1   
  
 
test f cachingdnsresolverfixture  cachehit    
  string hostname  foo bar com    
  cachingresolver - resolvehostname  cb   hostname   
    
  expect eq underlyingresolver - gethitcount    1   
 
  cachingresolver - resolvehostname  cb   hostname   
  expect eq underlyingresolver - gethitcount    1   
 
  expect eq cb  getnumsuccesses    2   
  
 
test f cachingdnsresolverfixture  cacheclearaftermax    
  initializeresolverwithparams  
      cachingdnsparams  cachingmaxsize   5   cachingclearsize   2 0 5 cachingresolver - resolvehostname  cb   folly std  string cachingresolver - resolvehostname  cb    6    
  expect eq underlyingresolver - gethitcount    6   
 
  cachingresolver - resolvehostname  cb    0    
  expect eq underlyingresolver - gethitcount    7   
  cachingresolver - resolvehostname  cb    1    
  expect eq underlyingresolver - gethitcount    8   
  
 
test f cachingdnsresolverfixture  cacheclearexpiredrecords    
    
  string hostname  foo    
  cachingresolver - resolvehostname  cb   hostname   
  expect eq underlyingresolver - gethitcount    1   
 
    
  cachingresolver - resolvehostname  cb   hostname   
  expect eq underlyingresolver - gethitcount    1   
 
  timeutil - advance std  chrono  milliseconds 5000    
 
    
  cachingresolver - resolvehostname  cb   hostname   
  expect eq underlyingresolver - gethitcount    2   
  
 
test f cachingdnsresolverfixture  stalecachehitafterfailure    
    
  string hostname  foo    
  cachingresolver - resolvehostname  cb   hostname   
  expect eq underlyingresolver - gethitcount    1   
 
  timeutil - advance std  chrono  milliseconds 5000    
 
  underlyingresolver - setisrunning cachingresolver - resolvehostname  cb   hostname   
  expect eq underlyingresolver - gethitcount    1   
  expect eq cb  getnumsuccesses    2   
