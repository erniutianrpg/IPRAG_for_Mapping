    underlyingresolver    dynamic cast dummydnsresolver   p check underlyingresolver    
    timeutil    timeutil cachingresolver    
        std  make unique cachingdnsresolver  std  move p   
                                             params cachingmaxsize  
                                             params cachingclearsize  
                                             params stalecachesizemultiplier  
                                             params stalecachettlmin  
