 proxygen  coro  test timedbatontest testing  test folly  eventbase  getexecutor eventbase  
    
 
  folly  eventbase eventbase  
  folly  cancellationsource cancelsource  
  timedbaton timedbaton  eventbase  std  chrono  milliseconds 0    
   
 
co test f x timedbatontest  timedbatontimeouttest    
  timedbaton settimeout std  chrono  milliseconds 500 res   co await timedbaton wait    
  expect eq res  timedbaton  status  timedout   
  expect eq timedbaton getstatus    timedbaton  status  timedout   
    
  timedbaton signal    
  expect eq timedbaton getstatus    timedbaton  status  timedout   
  
 
co test f x timedbatontest  timedbatonchangetimeouttest fut   
      co withexecutor  eventbase  timedbaton wait    start   via  eventbase   
  co await folly  coro  co reschedule current executor  
  expect timedbaton isscheduled     
  timedbaton settimeout std  chrono  milliseconds 500    
  expect timedbaton isscheduled res   co await std  move fut   
  expect eq res  timedbaton  status  timedout   
  expect eq timedbaton getstatus    timedbaton  status  timedout   
    
  timedbaton signal    
  expect eq timedbaton getstatus    timedbaton  status  timedout   
  
 
co test f x timedbatontest  timedbatonnotimeouttest fut   co withexecutor  eventbase  
                             folly  coro  co withcancellation  
                                 cancelsource gettoken    timedbaton wait     
                  start   
                  via  eventbase   
  co await folly  coro  co reschedule current executor  
  expect timedbaton isscheduled     
  cancelsource requestcancellation res   co await std  move fut   
  expect eq res  timedbaton  status  cancelled   
  expect eq timedbaton getstatus    timedbaton  status  cancelled   
  
 
co test f x timedbatontest  timedbatondisabletimeouttest    
    
  timedbaton settimeout std  chrono  milliseconds 500 fut   co withexecutor  eventbase  
                             folly  coro  co withcancellation  
                                 cancelsource gettoken    timedbaton wait     
                  start   
                  via  eventbase   
  co await folly  coro  co reschedule current executor  
  timedbaton settimeout std  chrono  milliseconds 0    
  expect timedbaton isscheduled     
  cancelsource requestcancellation res   co await std  move fut   
  expect eq res  timedbaton  status  cancelled   
  expect eq timedbaton getstatus    timedbaton  status  cancelled   
  
 
  
co test f x timedbatontest  timedbatonsignaltest    
  timedbaton settimeout std  chrono  seconds 1 signaltask      timedbaton  timedbaton  -  folly  coro  task timedbaton- signal    
    co co withexecutor  eventbase  signaltask  timedbaton   start res   co await timedbaton wait    
  expect eq res  timedbaton  status  signalled   
  expect eq timedbaton getstatus    timedbaton  status  signalled   
  
 
co test f x timedbatontest  timedbatoncanceltest    
  timedbaton settimeout std  chrono  seconds 1 fut   co withexecutor  eventbase  
                             folly  coro  co withcancellation  
                                 cancelsource gettoken    timedbaton wait     
                  start   
                  via  eventbase   
  cancelsource requestcancellation res   co await std  move fut   
  expect eq res  timedbaton  status  cancelled   
  expect eq timedbaton getstatus    timedbaton  status  cancelled   
 
    
  folly  cancellationsource cancelsource1  
  timedbaton reset fut2   co withexecutor  eventbase  
                              folly  coro  co withcancellation  
                                  cancelsource1 gettoken    timedbaton wait     
                   start   
                   via  eventbase canceltask   
         folly  cancellationsource  cancelsource  -  folly  coro  task cancelsource- requestcancellation    
    co co withexecutor  eventbase  canceltask  cancelsource1   start res2   co await std  move fut2   
  expect eq res2  timedbaton  status  cancelled   
  expect eq timedbaton getstatus    timedbaton  status  cancelled   
    
  timedbaton signal    
  expect eq timedbaton getstatus    timedbaton  status  cancelled   
  
 
co test f x timedbatontest  earlysignal    
  timedbaton settimeout std  chrono  milliseconds 10    
  timedbaton signal res   co await timedbaton wait    
  expect eq res  timedbaton  status  signalled   
  expect eq timedbaton getstatus    timedbaton  status  signalled   
  
 
co test f x timedbatontest  timedbatonrequestcancellationoutsideevb    
   
 
  folly  scopedeventbasethread otherscopedevb  
  folly  eventbase  otherevb   otherscopedevb geteventbase    
  folly  cancellationsource cancellationsource cancellationtoken   cancellationsource gettoken    
  via otherevb otherevb  cs   std  move cancellationsource otherevb- runafterdelay  
             cs   std  move cs       cs requestcancellation       100   
          
 
    
  timedbaton settimeout std  chrono  seconds 5 res   co await folly  coro  co withcancellation cancellationtoken  
                                                       timedbaton wait     
  expect eq res  timedbaton  status  cancelled   
  expect eq timedbaton getstatus    timedbaton  status  cancelled   
  
 
co test f x timedbatontest  timedbatondestroytest timedbaton2   
      std  make unique timedbaton   eventbase  std  chrono  seconds 10 fut   
      co withexecutor  eventbase  timedbaton2- wait    start   via  eventbase   
    
  co await folly  coro  co reschedule current executor  
  expect timedbaton2- isscheduled     
  timedbaton2 reset res   co await std  move fut   
  expect eq res  timedbaton  status  cancelled   
  
 
     proxygen lib http coro util test timedbatontest