  std  string result  
  folly  unhexlify input  result result  
  
    
 
test p rfcrequesttest  rfcexamplerequest    
  hpackencoder encoder getparam   first   
  hpackdecoder decoder  
    
  unique ptr iobuf  encoded   hpack  encodedecode req1  encoder  decoder   
  expect eq encoded- movetofbstring    unhexlify getparam   second 0     
  expect eq encoder gettable   bytes    57   
  expect eq encoder gettable   size    1   
 
    
  encoded   hpack  encodedecode req2  encoder  decoder   
  expect eq encoded- movetofbstring    unhexlify getparam   second 1     
  expect eq encoder gettable   bytes    110   
  expect eq encoder gettable   size    2   
 
    
  encoded   hpack  encodedecode req3  encoder  decoder   
  expect eq encoded- movetofbstring    unhexlify getparam   second 2     
  expect eq encoder gettable   bytes    164   
  expect eq encoder gettable   size    3   
  
 
instantiate test suite p huffman  rfcrequesttest    testing  values d3  d4    
 
test p rfcresponsetest  rfcexampleresponse    
    
  uint32 t tablesize   256  
  hpackencoder encoder getparam   first  tablesize   
  hpackdecoder decoder tablesize   
 
    
  unique ptr iobuf  encoded   hpack  encodedecode resp1  encoder  decoder   
  expect eq encoded- movetofbstring    unhexlify getparam   second 0     
  expect eq encoder gettable   bytes    222   
  expect eq encoder gettable   size    4   
  expect eq encoder getheader 64  name cache-control    
  expect eq encoder getheader 64  value encoded   hpack  encodedecode resp2  encoder  decoder   
  expect eq encoded- movetofbstring    unhexlify getparam   second 1     
  expect eq encoder gettable   bytes    222   
  expect eq encoder gettable   size    4   
 
    
  encoded   hpack  encodedecode resp3  encoder  decoder   
  expect eq encoded- movetofbstring    unhexlify getparam   second 2     
 
  expect eq encoder gettable   size    3   
  expect eq encoder gettable   bytes    215   
  
 
instantiate test suite p huffman  rfcresponsetest    testing  values d5  d6     proxygen lib http codec compress test rfcexamplestests