 proxygen  
 
test urltest  root    
  url u  http    www facebook com   0   
  expect u isvalid     
  expect eq u geturl     http   
  
 
test urltest  capitalsheme    
  url u  https    www facebook com   0   
  expect u isvalid     
  expect eq u geturl     https   
  
 
test urltest  invalid    
  url u1  https   
  expect u1 isvalid     
  expect eq u1 gethost         
  expect eq u1 getpath         
  url u2  https   
  expect u2 isvalid     
  expect eq u2 gethost     www facebook com    
  expect eq u2 getpath      foo xff    
  
 
test urltest  nonhttpscheme    
  url u1  masque   
    
  expect u1 isvalid     
  expect eq u1 gethost     www facebook com    
  expect eq u1 getpath      foo    
  
 
test urltest  getport    
  url u1  https   
  expect u1 isvalid     
  expect eq u1 getport    443   
  expect eq u1 gethostandportomitdefault     www facebook com    
 
  url u2  http   
  expect u2 isvalid     
  expect eq u2 getport    80   
  expect eq u2 gethostandportomitdefault     www facebook com    
 
  url u3  http   
  expect u3 isvalid     
  expect eq u3 getport    8081   
  expect eq u3 gethostandportomitdefault     www facebook com 8081    
 
  url u4  https   
  expect u4 isvalid     
  expect eq u4 getport    8081   
  expect eq u4 gethostandportomitdefault     www facebook com 8081    
   proxygen lib utils test urltest