 proxygen  
 
test rendezvoushash  consistency    
  rendezvoushash hashes  
  std  vector std  pair std  string  uint64 t   nodes 0 10 nodes emplace back folly std  string   key 1   
    
  hashes build nodes size t rank   0  rank   nodes size     2  rank      
    std  map uint64 t  size t  mapping 0 10000 mapping hashes rank key  expected    mapping    
      expect eq expected  hashes key  rank    
      
    
  
 
test rendezvoushash  consistencywithnewnode    
  rendezvoushash hashes numnodes   10  
  std  vector std  pair std  string  uint64 t   nodes 0 numnodes nodes emplace back folly std  string   key 1   
    
  hashes build nodes   
  std  map uint64 t  size t  mapping uint64 t 0 10000 mapping hashes hashes   rendezvoushash    
    
  nodes emplace back folly std  string   key   numnodes   1   
  hashes build nodes key  expected    mapping    
    size t id   hashes key   
    expect expected    id    numnodes id    
    
  
 
test rendezvoushash  consistencywithincreasedweight    
  rendezvoushash hashes numnodes   10  
  std  vector std  pair std  string  uint64 t   nodes 0 numnodes nodes emplace back folly std  string   key i   
    
  hashes build nodes   
 
  std  map uint64 t  size t  mapping uint64 t 0 10000 mapping hashes nodes clear    
  hashes   rendezvoushash 0 numnodes nodes emplace back folly std  string   key i   2   
    
  hashes build nodes key  expected    mapping    
    expect eq expected  hashes key    
    
  
 
test rendezvoushash  consistentflowtoincreasedweightnode    
  rendezvoushash hashes numnodes   10  
  std  vector std  pair std  string  uint64 t   nodes 0 numnodes nodes emplace back folly std  string   key i   
    
  hashes build nodes   
 
  std  map uint64 t  size t  mapping uint64 t 0 10000 mapping hashes nodes clear    
    
  hashes   rendezvoushash    
 
  nodes emplace back folly std  string   key   0   10 1 numnodes nodes emplace back folly std  string   key i   
    
  hashes build nodes key  expected    mapping    
    size t id   hashes key   
    expect expected    id    0 id    
    
  
 
test rendezvoushash  consistentflowtodecreasedweightnodes    
  rendezvoushash hashes numnodes   18  
  std  vector std  pair std  string  uint64 t   nodes 0 numnodes nodes emplace back folly std  string   key 100   
    
  hashes build nodes   
  std  map uint64 t  size t  mapping uint64 t 0 10000 mapping hashes nodes clear    
  hashes   rendezvoushash 0 5 nodes emplace back folly std  string   key 50 5 numnodes nodes emplace back folly std  string   key 100   
    
 
  hashes build nodes key  expected    mapping    
      
    size t id   hashes key   
    expect expected    id    id    5   
    
  
 
test rendezvoushash  consistentflowtodecreasedweightnode    
  rendezvoushash hashes numnodes   10  
  std  vector std  pair std  string  uint64 t   nodes 0 numnodes nodes emplace back folly std  string   key i   
    
  hashes build nodes   
  std  map uint64 t  size t  mapping uint64 t 0 10000 mapping hashes nodes clear    
  hashes   rendezvoushash 0 numnodes - 1 nodes emplace back folly std  string   key i   
    
 
    
  nodes emplace back folly std  string   key   numnodes - 1   0   
  hashes build nodes key  expected    mapping    
      
    size t id   hashes key expected     uint64 t numnodes - 1    
      expect expected    id expect expected    id   
      
    
  
 
test rendezvoushash  consistencywithdecreasedweight    
  rendezvoushash hashes numnodes   10  
  std  vector std  pair std  string  uint64 t   nodes 0 numnodes nodes emplace back folly std  string   key i   2   
    
  hashes build nodes   
  std  map uint64 t  size t  mapping uint64 t 0 10000 mapping hashes nodes clear    
  hashes   rendezvoushash 0 numnodes nodes emplace back folly std  string   key i   
    
  hashes build nodes key  expected    mapping    
    expect eq expected  hashes key    
    
  
 
test consistenthashring  distributionaccuracy    
  std  vector std  string  keys     
       ash proxy    prn proxy    snc proxy    frc proxy    
 
  std  vector std  vector uint64 t   weights     
       248  342  2  384   
       10  10  10  10   
       25  25  10  10   
       100  10  10  1   
       100  5  5  5   
       922337203685  12395828300  50192385101  59293845010 weight   weights    
    rendezvoushash hashes  
    std  vector std  pair std  string  uint64 t   nodes each range 0  keys size      
      nodes emplace back keys weight hashes build nodes   
 
    std  vector uint64 t  distribution keys size uint64 t 0 21000 distribution hashes uint64 t totalweight   0 w   weight    
      totalweight    w maxerror   0 0 size t 0 keys size expected   100 0   weight totalweight actual   100 0   distribution 21000  
 
      maxerror   std  max maxerror  fabs expected - actual    
      
      
    expect le maxerror  1 0   
    
  
 
test rendezvoushash  selectnunweighted    
  rendezvoushash hashes  
  std  vector std  pair std  string  uint64 t   nodes size   100 0 size nodes emplace back folly std  string   key 1   
    
  hashes build nodes seed   91484253 select   hashes selectnunweighted seed  size   10   
  expect eq select size    size 0 size expect eq select i rank   size   4  
  select   hashes selectnunweighted seed  rank   
  expect eq select size    rank   
  std  set size t  uniqueindex index   select    
    expect eq uniqueindex count index   0   
    uniqueindex insert index   
    expect lt index  size 1 100 select   hashes selectnunweighted seed rank different   0 index   select uniqueindex count index     0    
        different    
        
      
    expect gt different  0   
    
   proxygen lib utils test rendezvoushashtest