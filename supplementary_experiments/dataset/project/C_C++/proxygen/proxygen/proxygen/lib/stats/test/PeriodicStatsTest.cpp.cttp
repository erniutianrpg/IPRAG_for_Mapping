  expect eq copiedrefresheddata getlastupdatetime    
            periodstatsut - getcurrentdata   getlastupdatetime     
 
    
    
    
  periodicstatsuthelper - waitforrefresh newdata   periodstatsut - getcurrentdata copiednewdata   newdata  
  expect gt copiednewdata getlastupdatetime    
