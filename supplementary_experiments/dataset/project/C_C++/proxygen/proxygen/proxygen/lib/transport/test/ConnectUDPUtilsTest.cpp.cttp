 proxygen  
 
test connectudputilstest  expandtemplatebasic target   expandconnectudptemplate  
       https   
       192 0 2 6   
      443   
  expect eq target scheme   https    
  expect eq target authority   127 0 0 1 4443    
  expect eq target path    masque h 192 0 2 6 p 443    
  
 
test connectudputilstest  expandtemplateipv6 target   expandconnectudptemplate  
       https   
       2001 db8  1   
      8080   
  expect eq target scheme   https    
  expect eq target authority   proxy example 4443    
  expect eq target path    masque h 2001 3adb8 3a 3a1 p 8080    
  
 
test connectudputilstest  expandtemplatewellknown target   expandconnectudptemplate  
       https   
        target port     
       target example com   
      443   
  expect eq target scheme   https    
  expect eq target authority   proxy example 443    
  expect eq target path     well-known masque udp target example com 443     
  
 
test connectudputilstest  expandtemplatenopath target   
      expandconnectudptemplate  https   
  expect eq target scheme   https    
  expect eq target authority   proxy example 443    
  expect eq target path        
  
 
test connectudputilstest  prependcontextid payload   folly  iobuf  copybuffer  hello result   prependcontextid std  move payload    
  assert ne result result- coalesce    
  expect eq result- length    6   
  expect eq result- data   0   0x00   
  expect eq std  string result- data     1  5    hello    
  
 
test connectudputilstest  stripcontextidzero buf   folly  iobuf  create 6   
  buf- append 6   
  buf- writabledata   0    0x00  
  memcpy buf- writabledata     1   hello   5 result   stripcontextid std  move buf    
  assert result value     
  result value  - coalesce    
  expect eq std  string result value  - data    
                        result value  - length     
             hello    
  
 
test connectudputilstest  stripcontextidnonzero buf   folly  iobuf  create 6   
  buf- append 6   
  buf- writabledata   0    0x01  
  memcpy buf- writabledata     1   hello   5 result   stripcontextid std  move buf    
  expect result value     
  
 
test connectudputilstest  stripcontextidempty result   stripcontextid expect result value     
  
 
test connectudputilstest  stripcontextidemptypayload buf   folly  iobuf  create 1   
  buf- append 1   
  buf- writabledata   0    0x00 result   stripcontextid std  move buf    
  assert result value     
  expect eq result value  - computechaindatalength    0   
   proxygen lib transport test connectudputilstest