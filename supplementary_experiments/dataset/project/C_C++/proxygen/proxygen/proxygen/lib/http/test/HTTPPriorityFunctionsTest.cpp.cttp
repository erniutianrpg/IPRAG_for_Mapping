 proxygen  
 
test httppriorityfunctionstest  priorityheaderurgencyonly    
  httpmessage req  
 
    
  req getheaders   add http header priority   u 5 priority   httppriorityfromhttpmessage req   
  assert priority hasvalue     
  expect eq priority- urgency  5   
  expect priority- incremental   
  expect eq priority- requiredbps  0   
 
    
  req getheaders   set http header priority   u 3 priority   httppriorityfromhttpmessage req   
  assert priority hasvalue     
  expect eq priority- urgency  3   
  expect priority- incremental   
  expect eq priority- requiredbps  0   
  
 
test httppriorityfunctionstest  priorityheaderincrementalonly    
  httpmessage req  
 
    
  req getheaders   add http header priority priority   httppriorityfromhttpmessage req   
  assert priority hasvalue     
  expect eq priority- urgency  3   
  expect priority- incremental   
  expect eq priority- requiredbps  0   
 
    
  req getheaders   set http header priority priority   httppriorityfromhttpmessage req   
  assert priority hasvalue     
  expect eq priority- urgency  3   
  expect priority- incremental   
  expect eq priority- requiredbps  0   
 
    
  req getheaders   set http header priority 1    
  priority   httppriorityfromhttpmessage req   
  assert priority hasvalue     
  expect eq priority- urgency  3   
  expect priority- incremental   
  expect eq priority- requiredbps  0   
 
    
  req getheaders   set http header priority 0    
  priority   httppriorityfromhttpmessage req   
  assert priority hasvalue     
  expect eq priority- urgency  3   
  expect priority- incremental   
  expect eq priority- requiredbps  0   
  
 
test httppriorityfunctionstest  priorityheaderwhitespace    
  httpmessage req  
  req getheaders   add http header priority priority   httppriorityfromhttpmessage req   
  expect priority hasvalue     
 
  req getheaders   set http header priority   u 4 priority   httppriorityfromhttpmessage req   
  assert priority hasvalue     
  expect eq priority- urgency  4   
  expect priority- incremental   
  expect eq priority- requiredbps  0   
  
 
test httppriorityfunctionstest  priorityheaderurgencyandincremental    
  httpmessage req  
  req getheaders   add http header priority   u 4 priority   httppriorityfromhttpmessage req   
  assert priority hasvalue     
  expect eq priority- urgency  4   
  expect priority- incremental   
  expect eq priority- requiredbps  0   
  
 
test httppriorityfunctionstest  priorityheaderurgencyandincrementaluppercase    
  httpmessage req  
  req getheaders   add http header priority   u 4 priority   httppriorityfromhttpmessage req   
  expect priority hasvalue     
  
 
test httppriorityfunctionstest  priorityheaderbadurgency    
  httpmessage req  
  req getheaders   add http header priority   x 3 priority   httppriorityfromhttpmessage req   
  expect priority hasvalue     
 
    
  req getheaders   set http header priority   x 2 priority   httppriorityfromhttpmessage req   
    
  assert priority hasvalue     
  expect eq priority- urgency  3   
  expect priority- incremental   
  expect eq priority- requiredbps  0   
 
    
  req getheaders   set http header priority   u 8    
  priority   httppriorityfromhttpmessage req   
  expect priority hasvalue     
 
    
  req getheaders   set http header priority   u -2    
  priority   httppriorityfromhttpmessage req   
  expect priority hasvalue     
 
    
  req getheaders   set http header priority   u banana priority   httppriorityfromhttpmessage req   
  expect priority hasvalue     
  
 
test httppriorityfunctionstest  priorityheaderbadincremental    
  httpmessage req  
  req getheaders   add http header priority   u 3 0 priority   httppriorityfromhttpmessage req   
  expect priority hasvalue     
  
 
test httppriorityfunctionstest  priorityheaderbadpaused    
  httpmessage req  
  req getheaders   add http header priority   u 3  p 0 priority   httppriorityfromhttpmessage req   
  expect priority hasvalue     
  
 
test httppriorityfunctionstest  priorityheaderdefaultorderid    
  httpmessage req  
  req getheaders   add http header priority   u 3 priority   httppriorityfromhttpmessage req   
  expect eq priority- orderid  0   
  expect eq priority- requiredbps  0   
  
 
test httppriorityfunctionstest  priorityheadercustomorderid    
  httpmessage req  
  req getheaders   add http header priority   u 3  o 100 priority   httppriorityfromhttpmessage req   
  expect eq priority- urgency  3   
  expect eq priority- orderid  100   
  expect eq priority- requiredbps  0   
  
 
test httppriorityfunctionstest  priorityheaderdefaultunpaused    
  httpmessage req  
  req getheaders   add http header priority   u 3 priority   httppriorityfromhttpmessage req   
  expect priority- paused   
  expect eq priority- requiredbps  0   
  
 
test httppriorityfunctionstest  priorityheaderpaused    
  httpmessage req  
  req getheaders   add http header priority   u 3  p priority   httppriorityfromhttpmessage req   
  expect priority- paused   
  expect eq priority- requiredbps  0   
  
 
test httppriorityfunctionstest  priorityheaderrequiredratevalid    
  httpmessage req  
  req getheaders   add http header priority   u 0 r 5000000 priority   httppriorityfromhttpmessage req   
  assert priority hasvalue     
  expect eq priority- urgency  0   
  expect priority- incremental   
  expect eq priority- requiredbps  5000000   
  
 
test httppriorityfunctionstest  priorityheaderrequiredratezero    
  httpmessage req  
  req getheaders   add http header priority   u 3  r 0 priority   httppriorityfromhttpmessage req   
  assert priority hasvalue     
  expect eq priority- urgency  3   
  expect eq priority- requiredbps  0   
  
 
test httppriorityfunctionstest  priorityheaderrequiredrateonly    
  httpmessage req  
  req getheaders   add http header priority   r 1000000 priority   httppriorityfromhttpmessage req   
  assert priority hasvalue     
  expect eq priority- urgency  kdefaulthttppriorityurgency   
  expect priority- incremental   
  expect eq priority- requiredbps  1000000   
  
 
test httppriorityfunctionstest  priorityheaderbadrequiredrate    
  httpmessage req  
 
    
  req getheaders   add http header priority   u 3  r -100 priority   httppriorityfromhttpmessage req   
  expect priority hasvalue     
 
    
  req getheaders   set http header priority   u 5 r invalid    
  priority   httppriorityfromhttpmessage req   
  expect priority hasvalue     
 
    
  req getheaders   set http header priority   u 3  r 5000000    
  priority   httppriorityfromhttpmessage req   
  expect priority hasvalue     
  
 
test httppriorityfunctionstest  priorityheaderrequiredratelarge    
  httpmessage req  
    
  req getheaders   add http header priority   u 0  r 100000000000 priority   httppriorityfromhttpmessage req   
  assert priority hasvalue     
  expect eq priority- urgency  0   
  expect eq priority- requiredbps  100000000000ull   
  
 
test httppriorityfunctionstest  priorityheaderrequiredratezerovsomitted    
  httpmessage req  
    
  req getheaders   add http header priority   u 3  r 0 withzero   httppriorityfromhttpmessage req   
  assert withzero hasvalue     
  expect eq withzero- requiredbps  0   
    
  req getheaders   set http header priority   u 3 withomitted   httppriorityfromhttpmessage req   
  assert withomitted hasvalue     
  expect eq withomitted- requiredbps  0   
    
  expect eq withzero- requiredbps  withomitted- requiredbps   
  
 
test httppriorityfunctionstest  priorityheaderallparameters    
  httpmessage req  
  req getheaders   add http header priority   u 2 o 50  p  r 10000000 priority   httppriorityfromhttpmessage req   
  assert priority hasvalue     
  expect eq priority- urgency  2   
  expect priority- incremental   
  expect eq priority- orderid  50   
  expect priority- paused   
  expect eq priority- requiredbps  10000000   
  
 
test httppriorityfunctionstest  prioritytostringwithrequiredrate    
  httppriority prio 0 0 5000000   
  std  string result   httpprioritytostring prio   
  expect eq result   u 0 r 5000000    
  
 
test httppriorityfunctionstest  prioritytostringnorequiredrate    
  httppriority prio 3 0 0   
  std  string result   httpprioritytostring prio   
  expect eq result   u 3    
  
 
test httppriorityfunctionstest  priorityequalitywithrequiredrate    
  httppriority 1 10 5000000   
  httppriority b 1 10 5000000   
  httppriority c 1 10 6000000   
  httppriority d 1 10 0   
  expect b   
  expect c   
  expect d   
   proxygen lib http test httppriorityfunctionstest