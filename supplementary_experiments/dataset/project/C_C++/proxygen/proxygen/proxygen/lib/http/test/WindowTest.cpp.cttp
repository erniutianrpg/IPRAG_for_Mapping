 proxygen  
 
test windowtest  basic    
  window w 100   
  assert w free 10    
  assert eq w getsize    110   
  assert eq w getcapacity    100   
  assert w reserve 20    
  assert eq w getsize    90   
  assert w reserve 90    
  assert eq w getsize    0   
  assert w free 5    
  assert eq w getsize    5   
  assert w free 0    
  assert eq w getsize    5   
  
 
test windowtest  changecapacity    
  window w 100   
  assert w setcapacity 10    
  assert eq w getsize    10   
  assert eq w getcapacity    10   
  assert w reserve 7    
  assert w setcapacity 5    
  assert eq w getcapacity    5   
  assert eq w getsize    -2   
  assert w free 1    
  assert eq w getsize    -1   
  assert w setcapacity 6    
  assert eq w getsize    0   
  assert eq w getcapacity    6   
  assert w setcapacity 7    
  assert eq w getsize    1   
  assert eq w getcapacity    7   
  assert eq w getoutstanding    6   
  
 
test windowtest  exceedwindow    
  window w 100   
  assert w reserve 50    
  assert w reserve 40    
  assert eq w getsize    10   
  assert w reserve 20    
  
 
test windowtest  overflow    
  window w 0   
  assert w reserve std  numeric limits int32 t   max      
  
 
test windowtest  underflow    
  window w 100   
  assert w free 100      
  assert w free 100      
  assert eq w getsize    300   
  assert w free std  numeric limits int32 t   max        
  
 
test windowtest  hugereserve    
  window w 100   
  assert w reserve std  numeric limits uint32 t   max      
  
 
test windowtest  hugefree    
  window w1 0   
  assert w1 free std  numeric limits int32 t   max      
  window w2 1   
  assert w2 free std  numeric limits int32 t   max      
  
 
test windowtest  hugefree2 0 10 window w assert w free std  numeric limits int32 t   max assert w free 1    
    
  
 
test windowtest  bytesoutstanding    
  window w 100   
  assert eq w getoutstanding    0   
  assert w reserve 20    
  assert eq w getoutstanding    20   
  assert w free 30    
    
  assert eq w getoutstanding    0   
  
 
test windowtest  bytesoutstandingafterfail    
  window w 100   
  assert eq w getoutstanding    0   
  assert w reserve 110    
  assert eq w getoutstanding    0   
  
 
test windowtest  nonstrict    
  window w 100   
  assert w reserve 110 assert eq w getoutstanding    110   
  assert eq w getsize    -10   
  
 
test windowtest  newcapacityoverflow    
  window w 0   
  assert w free 10    
  assert eq w getoutstanding    0   
  assert eq w getsize    10   
  assert w setcapacity std  numeric limits int32 t   max   - 10    
  assert eq w getsize    std  numeric limits int32 t   max     
  assert w setcapacity std  numeric limits int32 t   max   - 9    
   proxygen lib http test windowtest