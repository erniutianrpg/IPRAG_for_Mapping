    sf  item item  bareitem   sf  bareitem  decimal sf  decimal -400    
                   parameters        
    structuredfieldsencoder encoder  
    expect eq encoder encodeitem item   sf  encodeerror  ok   
    expect eq encoder 0 4    
    
    
    sf  item item  bareitem   sf  bareitem  bytesequence  hello    
                   parameters        
    structuredfieldsencoder encoder  
    expect eq encoder encodeitem item   sf  encodeerror  ok   
    expect eq encoder agvsbg8      
    
    
    sf  item item  bareitem   sf  bareitem  displaystring  
                      std  string intended display xc3 xbc  
                                   sers      
                   parameters        
    structuredfieldsencoder encoder  
    expect eq encoder encodeitem item   sf  encodeerror  ok   
    expect eq encoder intended display c3 bcsers       
    
  
 
test structuredfieldsrfc9651test  decodeitem parameters areorderedlastwins    
    
  sf  item item  
  structuredfieldsdecoder decoder  5 foo bar flag b  0 foo   last      
  expect eq decoder decodeitem item   sf  decodeerror  ok   
 
  expect eq item parameters size    3   
  expect eq item parameters entries   0  key   foo    
  expect eq item parameters entries   1  key   flag    
  expect eq item parameters entries   2  key   b    
 
  assert ne item parameters foo expectbareitemvalue std  string   
       item parameters foo    sf  bareitem  type  string   last    
 
  assert ne item parameters flag expectbareitemvalue item parameters flag    sf  bareitem  type  boolean assert ne item parameters b expectbareitemvalue item parameters b    sf  bareitem  type  boolean structuredfieldsencoder encoder  
  expect eq encoder encodeitem item   sf  encodeerror  ok   
  expect eq encoder 5 foo   last   flag b  0    
  
 
test structuredfieldsrfc9651test  decodelist innerlists parseandroundtrip std  string input       foo 1 b 2  lvl 5   bar baz  lvl 1       
  sf  list list  
  structuredfieldsdecoder decoder input   
  expect eq decoder decodelist list   sf  decodeerror  ok   
 
  assert eq list size    3   
  assert std  holds alternative sf  innerlist  list 0 first   std sf  innerlist  list 0    
  assert eq first items size    1   
  expectbareitemvalue std  string   
      first items 0  bareitem  sf  bareitem  type  string   foo    
  assert ne first items 0  parameters expectbareitemvalue int64 t   
       first items 0  parameters sf  bareitem  type  integer  1   
  assert ne first parameters lvl expectbareitemvalue int64 t   
       first parameters lvl    sf  bareitem  type  integer  5   
 
  assert std  holds alternative sf  innerlist  list 2     
  expect std sf  innerlist  list 2   items empty     
 
  structuredfieldsencoder encoder  
  expect eq encoder encodelist list   sf  encodeerror  ok   
  expect eq encoder input   
  
 
