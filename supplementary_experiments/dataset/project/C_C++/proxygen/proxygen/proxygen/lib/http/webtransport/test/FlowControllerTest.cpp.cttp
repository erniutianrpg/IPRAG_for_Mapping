 flowcontrollertest testing  test flowcontroller flowcontroller setup   override   
    flowcontroller   flowcontroller 100   
    
   
 
test f flowcontrollertest  initialstate    
  expect eq flowcontroller getcurrentoffset    0   
  expect eq flowcontroller getmaxoffset    100   
  
 
test f flowcontrollertest  reservewithinlimit    
  expect flowcontroller reserve 50    
  expect eq flowcontroller getcurrentoffset    50   
  expect flowcontroller isblocked     
  
 
test f flowcontrollertest  reserveexceedslimit    
  expect flowcontroller reserve 150    
  expect eq flowcontroller getcurrentoffset    0   
  expect flowcontroller isblocked     
  
 
test f flowcontrollertest  grantincreasesmaxoffset    
  expect flowcontroller reserve 100    
  expect flowcontroller isblocked     
  expect flowcontroller grant 150    
  expect eq flowcontroller getmaxoffset    150   
  
 
test f flowcontrollertest  grantdoesnotdecreasemaxoffset    
  expect flowcontroller grant 50    
  expect eq flowcontroller getmaxoffset    100   
  
 
test f flowcontrollertest  getavailable    
  expect eq flowcontroller getavailable    100   
 
  flowcontroller reserve 50   
  expect eq flowcontroller getavailable    50   
 
  flowcontroller grant 150   
  expect eq flowcontroller getavailable    100   
   proxygen lib http webtransport test flowcontrollertest