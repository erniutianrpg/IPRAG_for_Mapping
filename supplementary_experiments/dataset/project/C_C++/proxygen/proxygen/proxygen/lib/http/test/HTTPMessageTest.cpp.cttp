  expect eq msg getcookie  id     1256679245    
  expect eq msg getcookie  data     0 1234567    
  expect eq msg getcookie  mising         
  
 
test httpmessage  testparsecookiesspaces    
  httpmessage msg  
 
  msg getheaders   add  cookie     id 1256679245     data 0 1234567       
  expect eq msg getcookie  id     1256679245    
  expect eq msg getcookie  data     0 1234567    
  
 
test httpmessage  testparsecookiessinglecookie    
  httpmessage msg  
 
  msg getheaders   add  cookie       user id 1256679245      
  expect eq msg getcookie  user id     1256679245    
  
 
test httpmessage  testparsecookiesmultiplecookies    
  httpmessage msg  
 
  msg getheaders   add  cookie   
                        id 1256679245  data 0 1234567  same always  name    
  msg getheaders   add  cookie   
                        id2 1256679245  data2 0 1234567  same always      
  expect eq msg getcookie  id     1256679245    
  expect eq msg getcookie  id2     1256679245    
  expect eq msg getcookie  data     0 1234567    
  expect eq msg getcookie  data2     0 1234567    
  expect eq msg getcookie  same     always    
  expect eq msg getcookie  name         
  
 
test httpmessage  testremovecookie    
  httpmessage msg  
 
    
  msg getheaders   set  cookie   
                        id 1256679245  data 0 1234567  session abc123    
  expect eq msg getcookie  id     1256679245    
  expect eq msg getcookie  data     0 1234567    
  expect eq msg getcookie  session     abc123    
 
    
  msg removecookie  data    
  expect eq msg getcookie  id     1256679245    
  expect eq msg getcookie  data         
  expect eq msg getcookie  session     abc123 std  string  cookieheader   msg getheaders   getsingleorempty  cookie    
  expect cookieheader find  id 1256679245      std  string  npos   
  expect cookieheader find  session abc123      std  string  npos   
  expect cookieheader find  data 0 1234567      std  string  npos   
 
    
  msg removecookie  id    
  expect eq msg getcookie  id         
  expect eq msg getcookie  session     abc123    
 
    
  msg removecookie  session    
  expect eq msg getcookie  session         
  expect msg getheaders   exists  cookie     
  
 
test httpmessage  testremovecookienonexistent    
  httpmessage msg  
 
    
  msg getheaders   set  cookie    id 1256679245  data 0 1234567    
 
    
  msg removecookie  nonexistent    
 
    
  expect eq msg getcookie  id     1256679245    
  expect eq msg getcookie  data     0 1234567 std  string  cookieheader   msg getheaders   getsingleorempty  cookie    
  expect cookieheader find  id 1256679245      std  string  npos   
  expect cookieheader find  data 0 1234567      std  string  npos   
  
 
test httpmessage  testremovecookieemptyheader    
  httpmessage msg  
 
    
  msg removecookie  nonexistent    
 
  expect msg getheaders   exists  cookie     
  expect eq msg getcookie  nonexistent         
  
 
test httpmessage  testparsequeryparamssimple    
  httpmessage msg  
  string url   
        test seq 123456 userid 1256679245 dup 1 dup 2 helloworld  
        second clear  28already 29 3f   
 
  msg seturl url   
  expect eq msg getqueryparam  seq     123456    
  expect eq msg getqueryparam  userid     1256679245    
  expect eq msg getqueryparam  dup     2    
  expect eq msg getqueryparam  helloworld         
  expect eq msg getintqueryparam  dup   5   2   
  expect eq msg getintqueryparam  abc   5   5   
  expect eq msg getdecodedqueryparam  second clear  already      
  expect eq msg getdecodedqueryparam  seq     123456    
  expect eq msg hasqueryparam  seq expect eq msg hasqueryparam  seq1 expect eq msg getintqueryparam  dup    2   
  expect any msg getintqueryparam  abc     
  expect any msg getintqueryparam  second param   msg getqueryparam  seq    
  msg setqueryparam  foo    bar    
  expect eq param   123456    
  msg removequeryparam  foo    
  expect eq param   123456    
  
 
test httpmessage  testparsequeryparamscomplex    
  httpmessage msg  
  std  vector std  vector std  string   input     
                    
        key equal value             
        only key            
        key value         value    
        key value 2         value2    
        key value 3         value3 0 1    input size std  vector std  vector std  string   sub size t j   0  j   input size      j 1    j      
        sub push back input j    
        
      
 
    sort sub begin    sub end first std  string url     test val   sub first    
          first url         
          
 
        url    val 0    val 1    val 2   
        
 
      msg seturl url val   sub val 0  empty expect eq val 2   msg getqueryparam val 0 next permutation sub begin    sub end      
    
  
 
