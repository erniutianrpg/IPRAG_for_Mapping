test httpheaders  cleartest    
  httpheaders headers size t 0 kinitialvectorreserve   2 headers add folly std  string std  string 50 expect eq headers getsingleorempty  25   0    z    
  headers removeall    
  expect eq headers size    0 size t 0 kinitialvectorreserve   2 headers add folly std  string std  string 50 expect eq headers getsingleorempty  25   0    z copyandmovetest size t multiplier    
  httpheaders headers size t 0 kinitialvectorreserve   multiplier headers add folly std  string std  string 50 httpheaders headers2 headers   
  expect eq headers2 getsingleorempty  3   0    d    
  httpheaders headers3  
  headers3 add  blown    away    
  headers3   headers2  
  expect eq headers2 getsingleorempty  4   0    e    
  httpheaders headers4 std  move headers3    
  expect eq headers4 getsingleorempty  5   0    f    
  httpheaders headers5  
  headers5 add  blown    away    
  headers5   std  move headers4   
  expect eq headers5 getsingleorempty  6   0    g    
  
 
