test f testkeepalive  useafterfree    
    
    
  awaitablenoop obj  
  expect eq obj numkeepalives    1   
  folly  coro  blockingwait obj zerorefs     
  expect eq obj numkeepalives    0   
 
    
  expect death obj acquirekeepalive     use free    
  
 
test f testkeepalive  simplememberaccess    
  awaitablenoop obj  
    
  detail  keepaliveptr awaitablenoop  ka  
  xcheck  ka   
 
  ka   obj acquirekeepalive    
  expect eq ka- val  0   
  ka- val karef   ka  
  expect eq karef- val  1 refcounttest testing  test folly  eventbase evb   
