test f testkeepalive  copyconstructorassignment    
    
  awaitablenoop obj  
  expect eq obj numkeepalives    1   
 
  detail  keepaliveptr awaitablenoop  empty    
  expect empty ka   obj acquirekeepalive    
  expect eq obj numkeepalives    2 ka2   ka  
  expect eq obj numkeepalives    3   
    
  ka2   empty  
  expect eq obj numkeepalives    2   
    
  ka2   ka  
  expect eq obj numkeepalives    3   
  
 
  
test f testkeepalive  moveconstructorassignment    
    
  awaitablenoop obj  
  expect eq obj numkeepalives    1   
 
  detail  keepaliveptr awaitablenoop  empty    
  expect empty ka   obj acquirekeepalive    
  expect eq obj numkeepalives    2 ka2   std  move ka   
  expect eq obj numkeepalives    2   
  expect ka   
 
    
  ka2   std  move empty   
  expect eq obj numkeepalives    1   
 
    
  ka2   obj acquirekeepalive    
  expect eq obj numkeepalives    2   
  
 
