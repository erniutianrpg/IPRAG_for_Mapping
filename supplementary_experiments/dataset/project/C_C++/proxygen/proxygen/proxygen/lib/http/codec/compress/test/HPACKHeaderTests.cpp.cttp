 proxygen std hpackheadertests testing  test     
 
test f hpackheadertests  size    
  hpackheader h   path         
  expect eq h bytes    32   5   1   
  
 
test f hpackheadertests  operators    
  hpackheader h0   path         
  hpackheader h1   path         
  hpackheader h2   path     index php    
  hpackheader h3  x-fb-debug    test    
    
  expect h0    h1   
  expect h1    h2   
    
  expect h1   h1   
  expect h1   h2   
  expect h1   h3   
    
  expect h2   h2   
  expect h3   h2   
  expect h2   h1   
 
  stringstream out  
  out    h1  
  expect eq out str      path       
  
 
test f hpackheadertests  hasvalue    
  hpackheader h1   path        
  hpackheader h2   path         
  expect h1 hasvalue     
  expect h2 hasvalue     
  
 
test f hpackheadertests  headerindexingstrategybasic    
  headerindexingstrategy indexingstrat  
  hpackheader path   path    index php q 42    
  expect indexingstrat indexheader path name  path value    
  hpackheader cdn   path     hprofile-ak-prn1 49496 6024432 1026115112 n jpg    
  expect indexingstrat indexheader cdn name  cdn value    
  hpackheader clen  content-length    512    
  expect indexingstrat indexheader clen name  clen value    
  hpackheader data  data    value    
  expect indexingstrat indexheader data name  data value hpackheadernametest testing  test     
 
hpackheadername destroyedhpackheadername std  string name    
    
  hpackheadername headername name headername  
  
 
test f hpackheadernametest  testconstructor    
    
  hpackheadername name1  accept-encoding    
  hpackheadername name2  content-length    
  hpackheadername name3  uncommon-name    
  hpackheadername name4  uncommon-name-2    
  expect eq name1 accept-encoding    
  expect eq name2 content-length    
  expect eq name3 uncommon-name    
  expect eq name4 uncommon-name-2    
  
 
test f hpackheadernametest  testcopyconstructor    
  hpackheadername name1  accept-encoding    
  hpackheadername name2  uncommon-name    
 
    
  hpackheadername name3 name1   
  hpackheadername name4 name2   
  hpackheadername name5 destroyedhpackheadername  x-fb-debug     
  hpackheadername name6 destroyedhpackheadername  uncommon-name     
  expect eq name3 accept-encoding    
  expect eq name4 uncommon-name    
  expect eq name5 x-fb-debug    
  expect eq name6 uncommon-name    
  
 
test f hpackheadernametest  testmoveconstructor    
  hpackheadername name1  accept-encoding    
  hpackheadername name2  uncommon-name    
 
    
  hpackheadername name3 std  move name1    
  hpackheadername name4 std  move name2    
  expect eq name3 accept-encoding    
  expect eq name4 uncommon-name    
  
 
test f hpackheadernametest  testassignmentoperators    
  std  string testheadername    accept-encoding   
 
  hpackheadername name1 testheadername   
  expect eq name1 testheadername   
 
    
  
  
  
  
  
  name1   name1  
  
  
  
  expect eq name1 testheadername   
  hpackheadername  pname1    name1  
    
    
  name1   std  move  pname1   
  expect eq name1 testheadername   
 
  std  string otherheadername    uncommon-name   
  hpackheadername name2 otherheadername   
  name1   name2  
  expect eq name1 otherheadername   
  expect eq name2 otherheadername   
 
  hpackheadername name3 testheadername   
  name1   std  move name3   
  expect eq name1 testheadername   
 
  name1   hpackheadername otherheadername   
  expect eq name1 otherheadername   
  
 
test f hpackheadernametest  testgetsize    
    
  hpackheadername name1  accept-encoding    
  hpackheadername name2  uncommon-header now    
  expect eq name1 size    15   
  expect eq name2 size    19   
  
 
test f hpackheadernametest  testoperators    
    
  hpackheadername name1  aaa    
  hpackheadername name2  bbb    
  hpackheadername name3  aaa    
  hpackheadername name4  bbb    
  check name1    name3   
  check name1    name2   
  check name1   name2   
  check name2   name1   
  check name1    name3   
  check name2    name1   
  check name2    name4   
  check name1    name2   
  
 
test f hpackheadernametest  testiscommonheader uint64 t j   0  j   httpcommonheaders  num codes    j code cast httpheadercode  j   
    hpackheader testhpackheader  httpcommonheaders  getpointertoname code checkresult   j    httpheadercodecommonoffset  
    expect eq testhpackheader name iscommonheader    checkresult   
    
  std  string externalheader    externalheader   
  hpackheader testhpackheader externalheader       
  expect testhpackheader name iscommonheader     
