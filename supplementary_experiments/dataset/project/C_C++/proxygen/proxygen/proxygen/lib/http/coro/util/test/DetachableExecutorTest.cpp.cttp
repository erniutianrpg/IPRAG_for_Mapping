 proxygen  coro  detail  
 
test detachableexecutor  simple    
  folly  eventbase evb  
  detachableexecutor exec  evb   
 
  uint8 t num fns executed 0   
    
    
  exec add   num fns executed        num fns executed      
  evb looponce evloop nonblock   
  expect eq num fns executed  1   
  
 
test detachableexecutor  acquireguardtest    
  folly  eventbase evb  
  detachableexecutor exec  evb   
 
    
  expect eq exec getstate    detachableexecutor  state  undetachable g   exec acquireguard    
    expect eq exec getstate    detachableexecutor  state  detachable   
    
  expect eq exec getstate    detachableexecutor  state  undetachable   
  
 
test detachableexecutor  testdetachpriortoadd    
    
  folly  eventbase evb  
  detachableexecutor exec  evb g   exec acquireguard    
    exec detachevb    
    
 
    
    
  expect death exec add            check failed    
  
 
test detachableexecutor  testdetachafteradd    
  folly  eventbase evb  
  detachableexecutor exec  evb runbeforeloop folly  eventbase  loopcallback runbeforeloop folly  func   fn    fn  std  move fn runloopcallback override   
      fn folly  func fn   
     
 
    
    
  uint8 t num fns executed 0   
  exec add   num fns executed        num fns executed      
  evb runbeforeloop runbeforeloop g   exec acquireguard    
    exec detachevb    
       
 
  evb looponce evloop nonblock   
  expect eq num fns executed  0   
 
    
    
  exec attachevb  evb   
  evb looponce evloop nonblock   
  expect eq num fns executed  1   
  
 
test detachableexecutor  addwhenscheduled    
  folly  eventbase evb  
  detachableexecutor exec  evb   
 
  uint8 t num fns executed 0 incfn           num fns executed       
 
    
    
  evb runinloop         
      
      
    exec add incfn   
      
  exec add   num fns executed        num fns executed      
 
    
  evb looponce evloop nonblock   
  expect eq num fns executed  1   
  evb looponce evloop nonblock   
  expect eq num fns executed  2   
   proxygen lib http coro util test detachableexecutortest