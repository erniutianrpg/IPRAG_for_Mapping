            callbacks  msg- gettrailers  - getsingleorempty  x-trailer-1     
  expect eq  chicken-kyiv   
            callbacks  msg- gettrailers  - getsingleorempty  x-trailer-2     
  
  expect eq upstreamcodec  getreceivedframecount    4   
  
  
 
