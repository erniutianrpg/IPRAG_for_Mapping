  expect upstreamcodec  isstreamingressegressallowed 2    
  parse    
  expect downstreamcodec  isstreamingressegressallowed 0    
  expect downstreamcodec  isstreamingressegressallowed 1    
  expect downstreamcodec  isstreamingressegressallowed 2    
  
 
