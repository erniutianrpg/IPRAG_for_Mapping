    downstreamcodec  generatepushpromise output   pushstream  req  assocstream   
 
    parseupstream    
    callbacks  expectmessage 2          
    expect eq callbacks  assocstreamid  assocstream   
    expect eq callbacks  headerscompleteid  pushstream headers   callbacks  msg- getheaders    
    expect eq  coolio   headers getsingleorempty http header user agent    
    callbacks  reset    
 
      
    httpmessage resp  
    resp setstatuscode 200   
    resp getheaders   add http header content type   text plain    
    downstreamcodec  generateheader output   pushstream  resp   
 
    parseupstream    
    callbacks  expectmessage 2  200   
    expect eq callbacks  headerscompleteid  pushstream   
    expect eq callbacks  assocstreamid  0   
    expect callbacks  msg- getheaders   exists http header date    
    expect eq  text plain   
              callbacks  msg- getheaders   getsingleorempty  
                  http header content type    
    callbacks  reset    
    
  
 
