 folly  io folly proxygen  huffman std huffmantests testing  test hufftree  tree    hufftree    
   
 
test f huffmantests  codes    
  uint32 t code  
  uint8 t bits  
    
  tie code  bits    tree  getcode  e    
  expect eq code  0x05   
  expect eq bits  5   
    
  tie code  bits    tree  getcode 0   
  expect eq code  0x1ff8   
  expect eq bits  13   
  tie code  bits    tree  getcode 255   
  expect eq code  0x3ffffee   
  expect eq bits  26   
  
 
test f huffmantests  size    
  uint32 t size  
  folly  fbstring onebyte  x    
  size   tree  getencodesize onebyte   
  expect eq size  1   
 
  folly  fbstring accept  accept-encoding    
  size   tree  getencodesize accept   
  expect eq size  11   
  
 
test f huffmantests  encode    
  uint32 t size  
    
  folly  fbstring gzip  gzip    
  iobufqueue bufqueue  
  queueappender appender  bufqueue  512   
    
  appender ensure 512   
 
  size   tree  encode gzip  appender   
  expect eq size  3 iobuf  buf   bufqueue front uint8 t  data   buf- data    
  expect eq data 0   0x9b     
  expect eq data 1   0xd9     
  expect eq data 2   0xab     
 
    
  folly  fbstring accept  accept-encoding    
  size   tree  getencodesize accept   
  uint32 t encodedsize   tree  encode accept  appender   
  expect eq size  encodedsize   
  
 
test f huffmantests  decode    
  uint8 t buffer 3   
    
  buffer 0    0x60    
  buffer 1    0xbf    
  folly  fbstring literal  
  tree  decode buffer  2  literal   
  expect eq literal    e    
 
    
  buffer 0    0x9b  
  buffer 1    0xd9  
  buffer 2    0xab  
  literal clear    
  tree  decode buffer  3  literal   
  expect eq literal   gzip    
 
    
  buffer 0    0x98  
  buffer 1    0xbf  
  literal clear    
  tree  decode buffer  2  literal   
  expect eq literal   ge    
  
 
 
 
test f huffmantests  nonprintabledecode    
    
  uint8 t buffer1 4     0xff  0xff  0xea  0xf8   
  folly  fbstring literal  
  tree  decode buffer1  4  literal   
  expect eq literal size    2   
  expect eq  uint8 t literal 0   9   
  expect eq  uint8 t literal 1   38   
 
    
    
  uint8 t buffer2 7     0xff  0xff  0xb1  0xff  0xff  0xf5  0xff   
  literal clear    
  tree  decode buffer2  7  literal   
  expect eq literal size    2   
  expect eq  uint8 t literal 0   1   
  expect eq  uint8 t literal 1   240   
  
 
test f huffmantests  examplecom    
    
  iobufqueue bufqueue  
  queueappender appender  bufqueue  512   
  appender ensure 512   
 
  folly  fbstring example  www example com    
  uint32 t size   tree  getencodesize example   
  expect eq size  12   
  uint32 t encodedsize   tree  encode example  appender   
  expect eq size  encodedsize   
 
  folly  fbstring decoded  
  tree  decode bufqueue front  - data    size  decoded   
  check eq example  decoded   
  
 
test f huffmantests  useragent    
  folly  fbstring user agent  
       mozilla 5 0  iphone  cpu iphone os 7 0 4 mac os x    
       applewebkit 537 51  
        1  khtml gecko  mobile 11b554a   
        fban fbios fbav 6 7 fbbv 566055 fbd  
       v iphone5 1 fbmd iphone fbsn iphone os fbsv 7 0 4 fbss 2    
       fbcr t fbid p  
       hone fblc en fbop 5     
  iobufqueue bufqueue  
  queueappender appender  bufqueue  512   
  appender ensure 512 hufftree  tree   hufftree    
  uint32 t size   tree getencodesize user agent   
  uint32 t encodedsize   tree encode user agent  appender   
  expect eq size  encodedsize   
 
  folly  fbstring decoded  
  tree decode bufqueue front  - data    size  decoded   
  check eq user agent  decoded   
  
 
 
 
test f huffmantests  fitinbuffer    
  iobufqueue bufqueue  
  queueappender appender  bufqueue  128   
 
    
  folly  fbstring literal      
  tree  encode literal  appender   
 
    
  appender ensure 128   
  appender append appender length   - 1   
  literal    g   
  tree  encode literal  appender   
  check eq appender length    0   
  
 
 
 
