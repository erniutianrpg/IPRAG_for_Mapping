  expect eq 135  transinfo rtt count     
  expect eq 246  transinfo rtt var   
  expect eq 5  transinfo cwnd   
  expect eq 5   quic  kdefaultudpsendpacketlen  transinfo cwndbytes   
  expect eq 513  transinfo rtx   
  expect eq 90  transinfo rtx tm   
  expect eq 34  transinfo rto   
  expect eq 23  transinfo totalbytes quicprotocolinfo   
      dynamic cast quicprotocolinfo   transinfo protocolinfo expect eq 0  quicprotocolinfo- ptocount   
  expect eq 0  quicprotocolinfo- totalptocount   
