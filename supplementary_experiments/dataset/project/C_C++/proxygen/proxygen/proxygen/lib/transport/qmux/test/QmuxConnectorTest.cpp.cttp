test f qmuxconnectortest  connect succeeds state   std  make unique testcorotransport  state transport   std  make unique testcorotransport   evb   state transport- addreadevent tprecord samplepeerparams result   runconnector std  move transport    
  assert result hasexception       result exception assert ne result value expect state- writeevents empty     
  
 
  
test makewtconfigtest  mapsparamscorrectly self   sampleselfparams peer   samplepeerparams cfg   makewtconfig self  peer   
 
  expect eq cfg selfmaxstreamsbidi  self initialmaxstreamsbidi   
  expect eq cfg selfmaxconndata  self initialmaxdata   
  expect eq cfg selfmaxstreamdatabidi  self initialmaxstreamdatabidilocal   
  expect eq cfg selfmaxstreamdatauni  self initialmaxstreamdatauni   
  expect eq cfg peermaxstreamsbidi  peer initialmaxstreamsbidi   
  expect eq cfg peermaxconndata  peer initialmaxdata   
  expect eq cfg peermaxstreamdatabidi  peer initialmaxstreamdatabidiremote   
  expect eq cfg peermaxstreamdatauni  peer initialmaxstreamdatauni   
  
 
  
