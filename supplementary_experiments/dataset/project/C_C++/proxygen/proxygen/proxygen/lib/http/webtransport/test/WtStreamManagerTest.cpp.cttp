  check bidi readhandle    bidi writehandle   
 
    
  wtreadcallback rcb  
  streammanager setreadcb  bidi readhandle   rcb   
 
  bidi writehandle- writestreamdata  
      makebuf 10 read   bidi readhandle- readstreamdata    
  expect read isready     
    
  streammanager enqueue  bidi readhandle    data   makebuf 10    fin expect read isready     
  expect std  exchange rcb signalled streammanager enqueue  bidi readhandle    data   makebuf 10    fin read   bidi readhandle- readstreamdata    
  expect read isready     
  expect std  exchange rcb signalled test wtstreammanager  deliverycallback    
  wtconfig config  peermaxstreamsuni   5   
  wtsmegresscb egresscb  
  wtsmingresscb ingresscb priorityqueue   std  make unique quic  httppriorityqueue     
  wtstreammanager streammanager  
      detail  wtdir  client  config  egresscb  ingresscb   priorityqueue   
 
  mockdeliverycallback cb1  cb2  cb3  cb4  cb5 h1   check notnull streammanager createegresshandle     
  h1- writestreamdata makebuf 100 cb1 deq1   streammanager dequeue  h1  100   
  expect eq deq1 data- computechaindatalength    100   
  expect deq1 fin   
  expect eq deq1 deliverycallback   cb1   
  expect eq deq1 lastbytestreamoffset  99 h2   check notnull streammanager createegresshandle     
  h2- writestreamdata makebuf 100 cb1   
  h2- writestreamdata makebuf 50 cb2   
  h2- writestreamdata makebuf 75 cb3 d2a   streammanager dequeue  h2  100   
  expect eq d2a data- computechaindatalength    100   
  expect eq d2a deliverycallback   cb1   
  expect eq d2a lastbytestreamoffset  99 d2b   streammanager dequeue  h2  100   
  expect eq d2b data- computechaindatalength    50   
  expect eq d2b deliverycallback   cb2   
  expect eq d2b lastbytestreamoffset  149 d2c   streammanager dequeue  h2  100   
  expect eq d2c data- computechaindatalength    75   
  expect d2c fin   
  expect eq d2c deliverycallback   cb3   
  expect eq d2c lastbytestreamoffset  224 h3   check notnull streammanager createegresshandle     
  h3- writestreamdata makebuf 100 h3- writestreamdata makebuf 100 h3- writestreamdata makebuf 50 cb4 deq3   streammanager dequeue  h3  300   
  expect eq deq3 data- computechaindatalength    250   
  expect deq3 fin   
  expect eq deq3 deliverycallback   cb4   
  expect eq deq3 lastbytestreamoffset  249 h4   check notnull streammanager createegresshandle     
  h4- writestreamdata makebuf 100 cb5 d4a   streammanager dequeue  h4  60   
  expect eq d4a data- computechaindatalength    60   
  expect eq d4a deliverycallback expect eq d4a lastbytestreamoffset  59 d4b   streammanager dequeue  h4  60   
  expect eq d4b data- computechaindatalength    40   
  expect d4b fin   
  expect eq d4b deliverycallback   cb5   
  expect eq d4b lastbytestreamoffset  99 h5   check notnull streammanager createegresshandle     
  h5- writestreamdata makebuf 50 d5a   streammanager dequeue  h5  100   
  expect eq d5a data- computechaindatalength    50   
  expect eq d5a deliverycallback expect eq d5a lastbytestreamoffset  49   
 
  h5- writestreamdata cb1 d5b   streammanager dequeue  h5  100   
  expect eq d5b data- computechaindatalength    0   
  expect d5b fin   
  expect eq d5b deliverycallback   cb1   
