test f webtransportfiltertest  onclosewebtransportsessioncapsule    
    
    
  expect call  filter   onclosesession     
       willonce invoke closewebtransportsessioncapsule  capsule    
        filter - webtransportfilter  onclosesession capsule   
           
  expect call  handler   onsessionend optional uint32 t  wt code capsuledata   createclosesessioncapsule    
  filter - onbody std  move capsuledata    
  
 
test f webtransportfiltertest  onclosewebtransportsessioncapsulenohandler    
    
  filter - sethandler capsuledata   createclosesessioncapsule    
    
  expect filter - onbody std  move capsuledata     
  
 
test f webtransportfiltertest  multiplecapsulesinonebody    
  folly  iobufqueue queue firstcapsule   createclosesessioncapsule wt code   
  queue append std  move firstcapsule secondcapsule   createclosesessioncapsule wt code   1   
  queue append std  move secondcapsule    
 
  expect call  filter   onclosesession     
       times 2  
       willrepeatedly  
          invoke closewebtransportsessioncapsule  capsule    
            filter - webtransportfilter  onclosesession capsule   
               
 
    
  expect call  handler   onsessionend optional uint32 t  wt code     
 
  filter - onbody queue move     
  
 
test f webtransportfiltertest  streamcreationlimits filter   
      std  make unique webtransportfilter  txn codecversion  h2   
 
    
  expect filter- cancreateunistream     
  expect filter- cancreatebidistream     
 
  wtmaxstreamscapsule unicapsule 2   
  wtmaxstreamscapsule bidicapsule 3   
  filter- onmaxstreamsuni unicapsule   
  filter- onmaxstreamsbidi bidicapsule   
  expect filter- cancreateunistream     
  expect filter- cancreatebidistream uniresult1   filter- newwebtransportunistream    
  expect uniresult1 hasvalue     
  expect eq uniresult1 value    3   
  expect filter- cancreateunistream uniresult2   filter- newwebtransportunistream    
  expect uniresult2 hasvalue     
  expect eq uniresult2 value    7   
 
    
    
  expect filter- cancreateunistream bidiresult1   filter- newwebtransportbidistream    
  expect bidiresult1 hasvalue     
  expect eq bidiresult1 value    1   
  expect filter- cancreatebidistream bidiresult2   filter- newwebtransportbidistream bidiresult3   filter- newwebtransportbidistream    
  expect bidiresult2 hasvalue     
  expect bidiresult3 hasvalue     
 
    
    
  expect filter- cancreatebidistream     
  
 
