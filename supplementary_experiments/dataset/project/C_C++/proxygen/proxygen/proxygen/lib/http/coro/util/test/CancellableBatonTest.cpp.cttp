 proxygen  coro  test   
 
test cancellablebatontest  simple    
  folly  manualexecutor executor  
  detail  cancellablebaton baton fut   co withexecutor  executor  baton wait    startinlineunsafe    
 
    
  expect fut isready     
  expect eq executor step    0   
  expect eq executor step    0   
  expect eq executor step    0   
  expect eq executor step    0   
 
    
  baton signal    
  expect gt executor drain    0   
 
  expect fut hasvalue     
  expect eq fut value    timedbaton  status  signalled   
  
 
test cancellablebatontest  alreadysignalled    
  folly  manualexecutor executor  
  detail  cancellablebaton baton  
  baton signal fut   co withexecutor  executor  baton wait    startinlineunsafe    
 
    
  expect fut isready     
  executor drain    
 
  expect fut hasvalue     
  expect eq fut value    timedbaton  status  signalled   
 
  baton reset    
  
 
test cancellablebatontest  cancelviaanotherthread    
  folly  manualexecutor executor  
  folly  cancellationsource cs    
  folly  optional detail  cancellablebaton  cancellablebaton std place t t   std  thread         cs requestcancellation waittask   folly  coro  co withcancellation  
      cs gettoken    cancellablebaton value   wait res   folly  coro  blockingwait std  move waittask    executor   
  expect eq res  timedbaton  status  cancelled   
 
  t join    
  
 
test cancellablebatontest  timeout    
  folly  eventbase evb  
  detail  cancellablebaton baton res   folly  coro  blockingwait  
      baton timedwait  evb  std  chrono  milliseconds 250     evb   
 
  expect eq res  timedbaton  status  timedout   
  
 
test cancellablebatontest  timeoutdetach    
  folly  eventbase evb  
  detail  detachablecancellablebaton baton fut   co withexecutor  
                  evb  baton timedwait  evb  std  chrono  milliseconds 10    
                  startinlineunsafe    
  expect baton gettimercb  - isscheduled     
 
  baton detach    
  expect baton gettimercb  - isscheduled     
 
  folly  eventbasethreadtimekeeper tk evb   
  folly  coro  blockingwait folly  coro  sleep std  chrono  milliseconds 20     
 
    
  expect fut isready     
 
  baton signal res   folly  coro  blockingwait std  move fut    evb   
 
  expect eq res  timedbaton  status  signalled   
  
 
test cancellablebatontest  postbeforetimeoutexpires    
  folly  eventbase evb  
  detail  detachablecancellablebaton baton  
 
    
  evb runafterdelay  
              
        baton signal    
          
          
          
          
        expect ne baton gettimercb 25 res   folly  coro  blockingwait  
      baton timedwait  evb  std  chrono  milliseconds 250     evb   
 
  expect eq res  timedbaton  status  signalled   
 
    
  expect eq evb timer   count    0   
  
 
     proxygen lib http coro util test cancellablebatontest