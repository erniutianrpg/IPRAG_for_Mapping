  folly  eventbase evb testresolver   caresresolver  newresolver    
  testresolver- attacheventbase  evb   
  testresolver- setservers  folly  socketaddress  127 0 0 1   serverport     
  testresolver- setport serverport   
  testresolver- init    
 
    
  loopterminatingcallback cb1 evb   
  testresolver- resolvehostname  
       cb1   test example com   std  chrono  milliseconds 5000   af inet   
  evb loopforever    
  expect cb1 success    
  assert eq cb1 answers  size    1u   
  expect eq cb1 answers  0  address getaddressstr     192 0 2 1    
 
    
    
    
  loopterminatingcallback cb2 evb   
  testresolver- resolvehostname  
       cb2   test example com   std  chrono  milliseconds 5000   af inet   
  evb loopforever    
  expect cb2 success    
  assert eq cb2 answers  size    1u   
  expect eq cb2 answers  0  address getaddressstr     192 0 2 2    
 
    
  serverthread join    
  expect eq querieshandled load    2   
 
  testresolver reset    
  close serversock   
  
 
test f caresresolvertest  samplescaresactivequeriesandopensockets    
  delayeddnsserver server  
 
  folly  eventbase evb testresolver   caresresolver  newresolver    
  recordingstatscollector stats  
  testresolver- attacheventbase  evb   
  testresolver- enablecaresstatesampling    
  testresolver- setservers  folly  socketaddress  127 0 0 1   server port       
  testresolver- setport server port     
  testresolver- setstatscollector  stats   
  testresolver- init    
 
  loopterminatingcallback cb evb   
  testresolver- resolvehostname  
       cb   test example com   std  chrono  milliseconds 5000   af inet   
 
  assert server waitforquery std  chrono  seconds 1     
  expect containssampleatleast stats activequeries    1    
  expect containssampleatleast stats opensockets    1    
  expect ge stats socketopens    size t 1    
 
  server respondandjoin    
  evb loopforever    
 
  expect cb success    
  expect containssample stats activequeries    0    
 
  testresolver reset    
  
 
test f caresresolvertest  caresstatesamplingisdisabledbydefault    
  delayeddnsserver server  
 
  folly  eventbase evb testresolver   caresresolver  newresolver    
  recordingstatscollector stats  
  testresolver- attacheventbase  evb   
  testresolver- setservers  folly  socketaddress  127 0 0 1   server port       
  testresolver- setport server port     
  testresolver- setstatscollector  stats   
  testresolver- init    
 
  loopterminatingcallback cb evb   
  testresolver- resolvehostname  
       cb   disabled example com   std  chrono  milliseconds 5000   af inet   
 
  assert server waitforquery std  chrono  seconds 1     
 
  server respondandjoin    
  evb loopforever    
 
  expect cb success    
  expect stats activequeries   empty     
  expect stats opensockets   empty     
  expect eq stats socketopens    size t 0    
  expect eq stats socketcloses    size t 0    
 
  testresolver reset    
  
 
