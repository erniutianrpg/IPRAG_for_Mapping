  assert ge serversock  0 timeval tv    
  tv tv sec   10  
  tv tv usec   0  
  setsockopt serversock  sol socket rcvtimeo   tv tv sockaddr serveraddr    
  serveraddr sin family   af inet  
  serveraddr sin addr s addr   htonl inaddr loopback   
  serveraddr sin port   0    
  assert eq bind serversock sockaddr   serveraddr serveraddr    
            0   
 
  socklen t addrlen serveraddr   
  assert eq getsockname serversock sockaddr   serveraddr   addrlen   
            0   
  uint16 t serverport   ntohs serveraddr sin port   
 
    
    
    
  std  atomic querieshandled 0   
  std  thread serverthread  serversock   querieshandled 0 2 sockaddr clientaddr    
      socklen t clientaddrlen clientaddr   
      std  array 512  query  
      ssize t n   recvfrom serversock  
                           query data    
                           query size    
                           0 sockaddr   clientaddr  
                            clientaddrlen n    0 size t questionend   findquestionend query cast size t  n    
 
        
      std  array 512  resp  
      memcpy resp data    query data    questionend   
      resp 2    0x81    
      resp 3    0x80    
      resp 6    0  
      resp 7    1    
 
        
      size t resplen   questionend  
      resp resplen      0xc0  
      resp resplen      0x0c    
      resp resplen      0x00  
      resp resplen      0x01    
      resp resplen      0x00  
      resp resplen      0x01    
      resp resplen      0x00  
      resp resplen      0x00  
      resp resplen      0x01  
      resp resplen      0x2c    
      resp resplen      0x00  
      resp resplen      0x04    
      resp resplen      192  
