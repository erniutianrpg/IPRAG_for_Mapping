test f echohandlerfixture  onproperrequestsendsresponse    
  expect call stats  recordrequest    willonce expect call stats  getrequestcount    willonce 5    
 
  httpmessage response  
  expect call  responsehandler  sendheaders     
       willonce doall savearg 0   response expect call  responsehandler  sendeom    willonce handler- onrequest std  make unique httpmessage      
  handler- oneom    
  handler- requestcomplete    
 
  expect eq  5   response getheaders   getsingleorempty  request-number     
  expect eq 200  response getstatuscode     
  
 
test f echohandlerfixture  replaysbodyproperly    
  expect call stats  recordrequest    willonce expect call stats  getrequestcount    willonce 5    
 
  httpmessage response  
  folly  fbstring body  
 
  expect call  responsehandler  sendheaders     
       willonce doall savearg 0   response expect call  responsehandler  sendbody     
       willrepeatedly doall invoke     std  shared ptr folly  iobuf  b    
                              body    b- movetofbstring expect call  responsehandler  sendeom    willonce handler- onrequest std  make unique httpmessage      
  handler- onbody folly  iobuf  copybuffer  part1     
  handler- onbody folly  iobuf  copybuffer  part2     
  handler- oneom    
  handler- requestcomplete    
 
  expect eq  5   response getheaders   getsingleorempty  request-number     
  expect eq 200  response getstatuscode     
  expect eq  part1part2   body   
