 phase vocoder mrealarr1 mimagearr1 nlength mlength slidelength rate mrealarr2 mimagearr2 timearr null phiarr null phasearr null arr1 null arr2 null arr3 null arr4 null tlen 0 flen 0  
 
	flen mlength 2 1  
	tlen ceilf nlength rate   
	  varange 0 nlength rate  timearr   
 
	phiarr   vlinspace 0  m pi slidelength  flen  0   
 
	phasearr   vnew flen  null   
	  vcangle mrealarr1 mimagearr1 flen phasearr   
 
	arr1   vnew flen  null   
	arr2   vnew flen  null   
 
	arr3   vnew flen  null   
	arr4   vnew flen  null 0 tlen k 0 alpha 0 rarr1 null iarr1 null rarr2 null iarr2 null  
 
		k floorf timearr alpha timearr floorf timearr k nlength   
			rarr1 mrealarr1 k mlength  
			iarr1 mimagearr1 k mlength memset arr1 0 flen   
			memset arr2 0 flen   
			rarr1 arr1  
			iarr1 arr2 k 1 nlength   
			rarr2 mrealarr1  k 1  mlength  
			iarr2 mimagearr1  k 1  mlength memset arr3 0 flen   
			memset arr4 0 flen   
			rarr2 arr3  
			iarr2 arr4  
		  
 
		  vcabs rarr1  iarr1  flen  arr1   
		  vcabs rarr2  iarr2  flen  arr2   
		  vmul value arr1   1-alpha   flen  null   
		  vmul value arr2  alpha  flen  null j 0 j flen j     
			mrealarr2 mlength j   arr1 j  arr2 j   cosf phasearr j    
			mimagearr2 mlength j   arr1 j  arr2 j   sinf phasearr j j flen l mlength 2-1 j mlength j   l--   
			mrealarr2 mlength j  mrealarr2 mlength l   
			mimagearr2 mlength j  -mimagearr2 mlength l   
		  
 
		  
		  vcangle rarr2 iarr2 flen arr1   
		  vcangle rarr1 iarr1 flen arr2 j 0 j flen j value 0  
 
			value arr1 j -arr2 j -phiarr j   
			value value-2 m pi roundf value  2 m pi    
 
			phasearr j    phiarr j  value   
		  
	  
 
	free timearr   
	free phiarr   
	free phasearr   
 
	free arr1   
	free arr2   
