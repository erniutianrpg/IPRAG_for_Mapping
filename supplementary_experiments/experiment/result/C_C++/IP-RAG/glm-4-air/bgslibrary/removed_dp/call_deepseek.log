ig(cv::FileStorage &fs) {\n  fs << \"matchingThreshold\" << matchingThreshold;\n  fs << \"updateFactor\" << updateFactor;\n  fs << \"showOutput\" << showOutput;\n}\n\nvoid TwoPoints::load_config(cv::FileStorage &fs) {\n  fs[\"matchingThreshold\"] >> matchingThreshold;\n  fs[\"updateFactor\"] >> updateFactor;\n  fs[\"showOutput\"] >> showOutput;\n}\n"}    
    
