lta > 0) cap_source += delta;\n        else           cap_sink -= delta;\n        flow += (cap_source < cap_sink) ? cap_source : cap_sink;\n        ((node*)i)->tr_cap = cap_source - cap_sink;\n      }\n    }\n  }\n}\n"}    
    
