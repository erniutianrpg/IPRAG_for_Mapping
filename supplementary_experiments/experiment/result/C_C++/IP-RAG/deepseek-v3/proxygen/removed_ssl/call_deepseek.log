    File content:
    {"language": "c/c++", "includes": ["bitset", "folly/Function.h", "glog/logging.h", "ostream", "vector"], "macros": [], "namespaces": ["detail", "proxygen"], "types": [{"kind": "class", "name": "ConditionalGate"}, {"kind": "enum", "name": "class"}], "functions": ["set(E e)", "get(E e)", "describe(std::ostream& os)", "invoke()"], "raw_excerpt": " \n\n#pragma once\n\n#include <bitset>\n#include <folly/Function.h>\n#include <glog/logging.h>\n#include <ostream>\n#include <vector>\n\nnamespace proxygen {\n\n \ntemplate <typename E, size_t N>\nclass ConditionalGate {\n  static_assert(std::is_enum<E>(), \"ConditionalGate type must be enum\");\n  static_assert(N > 0, \"N must be greater than 0\");\n\n public:\n   \n  [[nodiscard]] bool allConditionsMet() const {\n    return conditions_.all();\n  }\n\n   \n  void then(folly::Function<void()> f) {\n    if (conditions_.all()) {\n      f();\n    } else {\n      functions_.emplace_back(std::move(f));\n    }\n  }\n\n   \n  void set(E e) {\n    set(static_cast<size_t>(e));\n  }\n  void set(size_t i = 0) {\n    CHECK_LT(i, conditions_.size());\n    CHECK(!conditions_[i]);\n    conditions_[i] = true;\n    if (conditions_.all()) {\n      invoke();\n    }\n  }\n\n   \n  bool get(E e) const {\n    return get(static_cast<size_t>(e));\n  }\n  [[nodiscard]] bool get(size_t i = 0) const {\n    CHECK_LT(i, conditions_.size());\n    return conditions_[i];\n  }\n\n  void describe(std::ostream& os) const {\n    for (size_t i = 0; i < conditions_.size(); i++) {\n      os << i << \"=\" << static_cast<uint8_t>(conditions_[i]) << \" \";\n    }\n  }\n\n private:\n  void invoke() {\n    auto functions = std::move(functions_);\n    for (auto& f : functions) {\n      f();\n    }\n  }\n\n  std::bitset<N> conditions_;\n  std::vector<folly::Function<void()>> functions_;\n};\n\ntemplate <typename E, size_t N>\ninline std::ostream& operator<<(std::ostream& os,\n                                const ConditionalGate<E, N>& g) {\n  g.describe(os);\n  return os;\n}\n\nnamespace detail {\nenum class ReadyEnum { Ready = 0 };\n}\n \nusing ReadyGate = ConditionalGate<detail::ReadyEnum, 1>;\n\n}  \n"}    
    
